# Variables for the ontology-builder app only. Copy to apps/ontology-builder/.env (git-ignored) and fill in.
# This file is loaded before the root .env, so a key here overrides the base value (ADR-0012).
# List only what this app adds or changes; everything else comes from the root .env.
# Mark a key that may stay empty with a trailing "# optional".
#
# Example override of a base variable:
# CLAUDE_MODEL=claude-haiku-5-5

# Port of the local review GUI and API (binds to 127.0.0.1 only).
ONTOLOGY_BUILDER_PORT=8765
# Git-ignored work folder: pending change-set journal, LLM response cache for resumable runs, process locks.
# Relative paths are relative to the repo root.
ONTOLOGY_BUILDER_WORK_DIR=apps/ontology-builder/.work
# LLM mode: live (call Claude), record (call and save fixtures), replay (recorded fixtures only; used by tests).
ONTOLOGY_BUILDER_LLM_MODE=live
