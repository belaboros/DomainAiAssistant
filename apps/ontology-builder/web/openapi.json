{
  "components": {
    "schemas": {
      "ActionIn": {
        "properties": {
          "action": {
            "enum": [
              "include",
              "exclude",
              "approve",
              "reject",
              "deprecate",
              "level",
              "correct",
              "merge",
              "split",
              "reassign"
            ],
            "title": "Action",
            "type": "string"
          },
          "ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "action",
          "ids"
        ],
        "title": "ActionIn",
        "type": "object"
      },
      "ActionResultOut": {
        "properties": {
          "element_id": {
            "title": "Element Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "element_id",
          "ok",
          "message"
        ],
        "title": "ActionResultOut",
        "type": "object"
      },
      "ActionsOut": {
        "properties": {
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ActionResultOut"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "pending"
        ],
        "title": "ActionsOut",
        "type": "object"
      },
      "AuthorIn": {
        "properties": {
          "fields": {
            "additionalProperties": true,
            "title": "Fields",
            "type": "object"
          },
          "type": {
            "enum": [
              "statement",
              "term",
              "concept",
              "relation",
              "rule",
              "property"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "fields"
        ],
        "title": "AuthorIn",
        "type": "object"
      },
      "CommitOut": {
        "description": "``ok`` with the commit's ``sha`` (``None`` when nothing changed), or the hook output.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "output": {
            "title": "Output",
            "type": "string"
          },
          "sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha"
          }
        },
        "required": [
          "ok",
          "sha",
          "output"
        ],
        "title": "CommitOut",
        "type": "object"
      },
      "CorpusOut": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentOut"
            },
            "title": "Documents",
            "type": "array"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "source_path": {
            "title": "Source Path",
            "type": "string"
          }
        },
        "required": [
          "folder",
          "source_path",
          "documents"
        ],
        "title": "CorpusOut",
        "type": "object"
      },
      "CreateOntology": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scope": {
            "additionalProperties": true,
            "title": "Scope",
            "type": "object"
          }
        },
        "required": [
          "name",
          "scope"
        ],
        "title": "CreateOntology",
        "type": "object"
      },
      "DocumentOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "title": "DocumentOut",
        "type": "object"
      },
      "Done": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Done",
        "type": "object"
      },
      "ElementStatus": {
        "description": "Review status of an element (FR-23).",
        "enum": [
          "proposed",
          "included",
          "excluded",
          "approved",
          "rejected",
          "deprecated"
        ],
        "title": "ElementStatus",
        "type": "string"
      },
      "ElementsOut": {
        "properties": {
          "corpora": {
            "items": {
              "$ref": "#/components/schemas/CorpusOut"
            },
            "title": "Corpora",
            "type": "array"
          },
          "elements": {
            "items": {
              "$ref": "#/components/schemas/IndexEntryOut"
            },
            "title": "Elements",
            "type": "array"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          }
        },
        "required": [
          "elements",
          "corpora",
          "pending"
        ],
        "title": "ElementsOut",
        "type": "object"
      },
      "EstimateOut": {
        "properties": {
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          }
        },
        "required": [
          "model",
          "documents",
          "units",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "EstimateOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "IdOut",
        "type": "object"
      },
      "IndexEntryOut": {
        "description": "One element in the compact index the GUI filters (FR-19).",
        "properties": {
          "corpora": {
            "items": {
              "type": "string"
            },
            "title": "Corpora",
            "type": "array"
          },
          "definition": {
            "title": "Definition",
            "type": "string"
          },
          "documents": {
            "items": {
              "type": "string"
            },
            "title": "Documents",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "search": {
            "title": "Search",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ElementStatus"
          },
          "type": {
            "enum": [
              "statement",
              "term",
              "concept",
              "relation",
              "rule",
              "property"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "status",
          "level",
          "definition",
          "corpora",
          "documents",
          "search"
        ],
        "title": "IndexEntryOut",
        "type": "object"
      },
      "IngestIn": {
        "description": "A folder (under the sources root) as a new corpus, or units marked not ignorable.",
        "properties": {
          "confirm": {
            "default": false,
            "title": "Confirm",
            "type": "boolean"
          },
          "folder": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder"
          },
          "units": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Units"
          }
        },
        "title": "IngestIn",
        "type": "object"
      },
      "IngestOut": {
        "properties": {
          "commit": {
            "$ref": "#/components/schemas/CommitOut"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "commit"
        ],
        "title": "IngestOut",
        "type": "object"
      },
      "Level": {
        "description": "How important an element is for a reader of the domain (FR-13).",
        "enum": [
          "level-1",
          "level-2",
          "level-3",
          "ignorable"
        ],
        "title": "Level",
        "type": "string"
      },
      "PublishIn": {
        "properties": {
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "title": "PublishIn",
        "type": "object"
      },
      "PublishOut": {
        "properties": {
          "changelog": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changelog"
          },
          "commit": {
            "$ref": "#/components/schemas/CommitOut"
          },
          "offenders": {
            "items": {
              "$ref": "#/components/schemas/ReferenceOut"
            },
            "title": "Offenders",
            "type": "array"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ReferenceOut"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "version",
          "changelog",
          "offenders",
          "warnings",
          "commit"
        ],
        "title": "PublishOut",
        "type": "object"
      },
      "ReferenceOut": {
        "properties": {
          "element_id": {
            "title": "Element Id",
            "type": "string"
          },
          "element_label": {
            "title": "Element Label",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "string"
          },
          "target_label": {
            "title": "Target Label",
            "type": "string"
          },
          "target_status": {
            "title": "Target Status",
            "type": "string"
          }
        },
        "required": [
          "element_id",
          "element_label",
          "target_id",
          "target_label",
          "target_status"
        ],
        "title": "ReferenceOut",
        "type": "object"
      },
      "Role": {
        "enum": [
          "user",
          "domain_admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "properties": {
          "ontology": {
            "title": "Ontology",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "title": "User",
            "type": "string"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "writer": {
            "title": "Writer",
            "type": "boolean"
          }
        },
        "required": [
          "user",
          "role",
          "writer",
          "ontology"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SignIn": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "\\S",
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "role"
        ],
        "title": "SignIn",
        "type": "object"
      },
      "StatementIn": {
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "StatementIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local API of the ontology-builder review GUI (spec 0002).",
    "title": "OntologyBuilder",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ontologies": {
      "get": {
        "operationId": "ontologies_api_ontologies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Response Ontologies Api Ontologies Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ontologies",
        "tags": [
          "review"
        ]
      },
      "post": {
        "description": "Create and commit a new ontology (domain admin only, FR-1).",
        "operationId": "create_api_ontologies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOntology"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create",
        "tags": [
          "review"
        ]
      }
    },
    "/api/ontologies/{name}/actions": {
      "post": {
        "description": "One action on each ID, checked for role and status per ID (FR-17, FR-18).",
        "operationId": "act_api_ontologies__name__actions_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Act",
        "tags": [
          "review"
        ]
      }
    },
    "/api/ontologies/{name}/elements": {
      "get": {
        "description": "The compact index of every element; the optional filters are those of the GUI.",
        "operationId": "elements_api_ontologies__name__elements_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "statement",
                    "term",
                    "concept",
                    "relation",
                    "rule",
                    "property"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Level"
            }
          },
          {
            "in": "query",
            "name": "corpus",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Corpus"
            }
          },
          {
            "in": "query",
            "name": "document",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Document"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Elements",
        "tags": [
          "review"
        ]
      },
      "post": {
        "description": "An authored element; it must cite evidence (FR-22).",
        "operationId": "author_api_ontologies__name__elements_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Author",
        "tags": [
          "review"
        ]
      }
    },
    "/api/ontologies/{name}/elements/{element_id}": {
      "get": {
        "description": "One element: its evidence passages first, then the record and its decisions (FR-16).",
        "operationId": "element_api_ontologies__name__elements__element_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "title": "Element Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Element Api Ontologies  Name  Elements  Element Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Element",
        "tags": [
          "review"
        ]
      }
    },
    "/api/ontologies/{name}/ingestions": {
      "post": {
        "description": "Run an ingestion or on-demand extraction, only once its estimate is confirmed (FR-6).",
        "operationId": "ingest_api_ontologies__name__ingestions_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest",
        "tags": [
          "writes"
        ]
