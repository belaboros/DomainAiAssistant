    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82B5BJWECFNN10MNRT4KBXB a dai:Statement ;
    rdfs:label "Stairwells, corridors and escape routes must be kept free of objects." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EN ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82B5BJWECFNN10MNRT4KBXC a dai:Statement ;
    rdfs:label "The objects that must not be left in stairwells, corridors and escape routes include prams, shoes and pet equipment." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EN ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82B5BJWECFNN10MNRT4KBXD a dai:Statement ;
    rdfs:label "Smoking is not allowed in any shared indoor space." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EN ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82B5VQ6AQJZT0DHJWAXTBQQ a dai:Statement ;
    rdfs:label "The main doors of each building stay closed and locked from 22:00 to 06:00." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EQ ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82B5VQ6AQJZT0DHJWAXTBQR a dai:Statement ;
    rdfs:label "Residents open the main doors with their own key." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EQ ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82B5VQ6AQJZT0DHJWAXTBQS a dai:Statement ;
    rdfs:label "Residents must not let strangers into the building." ;
    dai:evidence :su_01M82B00WB34E68SXWEMVZ22EQ ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82B5VQ6AQJZT0DHJWAXTBQT a dai:Statement ;
