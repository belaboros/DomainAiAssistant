    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AF7YTEGBGGS9B245D10JB a dai:Statement ;
    rdfs:label "The puppy is praised when it relieves itself outside." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZA ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AF7YTEGBGGS9B245D10JC a dai:Statement ;
    rdfs:label "Between 8 and 16 weeks, the puppy should get to know many people, sounds, surfaces and traffic in a calm way." ;
