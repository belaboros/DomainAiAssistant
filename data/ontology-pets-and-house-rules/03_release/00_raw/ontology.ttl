    dai:level dai:level-1 ;
    dai:status dai:proposed .

:st_01M82AC66KMJH32E2MQ3Z7ZBK9 a dai:Statement ;
    rdfs:label "Before you get a dog, check that your home, your working hours and your budget fit the dog you want." ;
