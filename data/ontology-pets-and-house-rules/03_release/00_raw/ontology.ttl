    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AJ8HWH90DHFSC2JB20DFR a dai:Statement ;
    rdfs:label "A training session should always end with a success." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZR ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AJ8HWH90DHFSC2JB20DFS a dai:Statement ;
    rdfs:label "A dog training course with a certified trainer is recommended in the first year." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZS ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AJ8HWH90DHFSC2JB20DFT a dai:Statement ;
    rdfs:label "Dogs of breeds classified as dangerous must pass an obedience test." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZS ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AK1Z8YRQBGAGXAECRMD6B a dai:Statement ;
    rdfs:label "Dogs are social animals." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX2 ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AK1Z8YRQBGAGXAECRMD6C a dai:Statement ;
    rdfs:label "An adult dog must never be left alone at home for more than 6 hours." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX2 ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AK1Z8YRQBGAGXAECRMD6D a dai:Statement ;
    rdfs:label "Puppies should not be left alone for more than 2 hours." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX2 ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AK1Z8YRQBGAGXAECRMD6E a dai:Statement ;
    rdfs:label "Before leaving, the owner should walk the dog, leave water and a safe chew toy, and keep the departure low-key." ;
