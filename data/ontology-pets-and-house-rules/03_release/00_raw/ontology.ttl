:su_01M82GHYMP28WWGVJCAF7BMQCJ a dai:SourceUnit ;
    rdfs:label "**Small companion breeds** (for example, Maltese or Pug) need less space and less exercise and adapt well to flats." .

:su_01M82GHYMQYRXNHXCXTMK9HDNY a dai:SourceUnit ;
    rdfs:label "A puppy is a dog younger than 6 months. Puppies should not leave their mother before 8 weeks of age." .

:su_01M82GHYMQYRXNHXCXTMK9HDPA a dai:SourceUnit ;
    rdfs:label "Reward good behaviour immediately; ignore unwanted behaviour instead of shouting." .

:cn_01M82GM2G3AM0SX444VHV3202K a owl:Class,
