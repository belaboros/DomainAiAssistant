        :su_01M82ABDR30PE47ZK8WSGY3HX3,
        :su_01M82ABDR30PE47ZK8WSGY3HX7 ;
    dai:level dai:level-1 ;
    dai:status dai:proposed .

:su_01M82ABDR28HTPAFF4C44FRBZG a dai:SourceUnit ;
    rdfs:label "An adult dog needs at least two walks a day: 30 to 60 minutes in total for small breeds and up to 2 hours for large and working breeds. A puppy must be taken outside to relieve itself every 2 to 3 hours. Always pick up your dog's waste and put it in a waste bin." .

