    dai:level dai:level-1 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KMB a dai:Statement ;
    rdfs:label "A dog looks to its owner for direction." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZJ ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KMC a dai:Statement ;
    rdfs:label "The owner should be the dog's lead: a calm, consistent and confident leader whose signals the dog can trust." ;
