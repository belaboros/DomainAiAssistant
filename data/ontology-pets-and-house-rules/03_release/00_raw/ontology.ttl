    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AH1GXVV72WP99JQXMH6X8 a dai:Statement ;
    rdfs:label "A puppy must be taken outside to relieve itself every 2 to 3 hours." ;
