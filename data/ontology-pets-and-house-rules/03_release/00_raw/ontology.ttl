    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KMG a dai:Statement ;
    rdfs:label "Unwanted behaviour should be ignored instead of shouting." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZN ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KMH a dai:Statement ;
    rdfs:label "A dog that does not see its owner as a reliable lead may become anxious or try to take control." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZP ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AJ8HWH90DHFSC2JB20DFP a dai:Statement ;
    rdfs:label "Every dog should learn five basic commands: sit, down, stay, come and leave it." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZR ;
