    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AK1Z8YRQBGAGXAECRMD6F a dai:Statement ;
    rdfs:label "If a dog barks or howls while the owner is away, the owner should train it to be alone step by step, starting with a few minutes." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX3 ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AKNKGVB3WQ6AJ3QXNT51Q a dai:Statement ;
    rdfs:label "In a car, a dog must travel in a crate or wear a safety harness attached to the seat belt." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX5 ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AKNKGVB3WQ6AJ3QXNT51R a dai:Statement ;
    rdfs:label "A dog must never be left in a parked car in warm weather." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX5 ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AKNKGVB3WQ6AJ3QXNT51S a dai:Statement ;
    rdfs:label "For travel abroad, a dog needs a pet passport, a microchip and a valid rabies vaccination." ;
    dai:evidence :su_01M82ABDR30PE47ZK8WSGY3HX5 ;
    dai:level dai:level-3 ;
    dai:status dai:proposed .

