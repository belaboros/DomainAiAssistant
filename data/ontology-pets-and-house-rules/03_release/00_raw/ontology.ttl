:su_01M82GHYMP28WWGVJCAF7BMQCM a dai:SourceUnit ;
    rdfs:label "**Long-haired breeds** need more grooming than short-haired breeds." .

:cn_01M82GPTF0J0A1WWEWDR3G29FG a owl:Class,
        skos:Concept ;
    skos:prefLabel "leash training" ;
    dai:evidence :su_01M82GHYMQYRXNHXCXTMK9HDP3 ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:su_01M82GHYMP28WWGVJCAF7BMQCK a dai:SourceUnit ;
    rdfs:label "**Large and working breeds** (for example, Border Collie or German Shepherd) need more space, more exercise and more mental work." .

:su_01M82GHYMQYRXNHXCXTMK9HDP7 a dai:SourceUnit ;
    rdfs:label "Your dog looks to you for direction. Be its lead: a calm, consistent and confident leader whose signals it can trust." .

