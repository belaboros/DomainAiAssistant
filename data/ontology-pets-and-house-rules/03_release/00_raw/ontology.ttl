    dai:status dai:proposed .

:st_01M82AH1GXVV72WP99JQXMH6X5 a dai:Statement ;
    rdfs:label "An adult dog needs at least two walks a day." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZG ;
