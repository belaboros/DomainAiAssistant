    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KME a dai:Statement ;
    rdfs:label "The owner should set clear rules for the dog, such as whether it may lie on the sofa, and keep them." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZM ;
    dai:level dai:level-2 ;
    dai:status dai:proposed .

:st_01M82AHPS6SQKW9E9EPJYC3KMF a dai:Statement ;
    rdfs:label "Good behaviour should be rewarded immediately." ;
