    dai:level dai:level-3 ;
    dai:status dai:proposed .

:st_01M82AF7YTEGBGGS9B245D10J9 a dai:Statement ;
    rdfs:label "House training of a puppy starts on the first day." ;
    dai:evidence :su_01M82ABDR28HTPAFF4C44FRBZA ;
