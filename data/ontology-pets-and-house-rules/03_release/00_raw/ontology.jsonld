    {"@id": "ont:ru_01M82HCHQC6AK72JNVEQYR1KY0", "@type": "dai:Rule", "dai:action": "stay closed and locked from 22:00 to 06:00", "dai:actor": "main door of each building", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTN"}, {"@id": "ont:cn_01M82HCHQC6AK72JNVEQYR1KXN"}, {"@id": "ont:rl_01M82HCHQC6AK72JNVEQYR1KXW"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Main doors locked 22:00-06:00"},
    {"@id": "ont:ru_01M82HCHQC6AK72JNVEQYR1KY1", "@type": "dai:Rule", "dai:action": "open the main door with their own key", "dai:actor": "resident", "dai:condition": "from 22:00 to 06:00 when the main doors are locked", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTG"}, {"@id": "ont:cn_01M82HCHQC6AK72JNVEQYR1KXN"}, {"@id": "ont:cn_01M82HCHQC6AK72JNVEQYR1KXR"}, {"@id": "ont:rl_01M82HCHQC6AK72JNVEQYR1KXX"}, {"@id": "ont:rl_01M82HCHQC6AK72JNVEQYR1KXY"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Residents open doors with own key"},
    {"@id": "ont:ru_01M82HCHQC6AK72JNVEQYR1KY2", "@type": "dai:Rule", "dai:action": "let strangers into the building", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTG"}, {"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTN"}, {"@id": "ont:cn_01M82HCHQC6AK72JNVEQYR1KXS"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Do not let strangers in"},
    {"@id": "ont:ru_01M82HCHQC6AK72JNVEQYR1KY3", "@type": "dai:Rule", "dai:action": "report a lost key to the house management at once", "dai:actor": "resident", "dai:condition": "when a key is lost", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTH"}, {"@id": "ont:cn_01M82HCHQC6AK72JNVEQYR1KXV"}, {"@id": "ont:rl_01M82HCHQC6AK72JNVEQYR1KXZ"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Report lost keys at once"},
    {"@id": "ont:ru_01M82HDB2GRFNRYQMSRVHKV6C0", "@type": "dai:Rule", "dai:action": "use the shared laundry room from 07:00 to 21:00", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": {"@id": "ont:cn_01M82HDB2F6BK5KDQ92WEFACHJ"}, "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Laundry room usage hours"},
