    {"@id": "ont:ru_01M82GNRCASH6DKSRYKE0WQE83", "@type": "dai:Rule", "dai:action": "start house training the puppy on the first day", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GNRCASH6DKSRYKE0WQE7V"}, {"@id": "ont:cn_01M82GNRCASH6DKSRYKE0WQE7X"}, {"@id": "ont:rl_01M82GNRCASH6DKSRYKE0WQE80"}], "dai:scope": {"@id": "ont:co_01M82GHYMN49VHXB6YMXXC893Z"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "House training starts on the first day"},
    {"@id": "ont:ru_01M82GNRCASH6DKSRYKE0WQE84", "@type": "dai:Rule", "dai:action": "take the puppy outside", "dai:actor": "owner", "dai:condition": "after every meal, after every nap and after play", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GNRCASH6DKSRYKE0WQE7V"}, {"@id": "ont:cn_01M82GNRCASH6DKSRYKE0WQE7X"}], "dai:scope": {"@id": "ont:co_01M82GHYMN49VHXB6YMXXC893Z"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Take puppy outside after meals, naps and play"},
