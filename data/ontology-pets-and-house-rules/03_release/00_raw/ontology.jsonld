    {"@id": "ont:ru_01M82B7AD49EHMKTM1WFJFM31B", "@type": "dai:Rule", "dai:action": "carry out noisy work such as drilling", "dai:actor": "resident", "dai:condition": "on Saturdays from 09:00 to 12:00", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82B1AN7D1ZA7ABBS5RZ4XKB"}, {"@id": "ont:cn_01M82B7AD49EHMKTM1WFJFM312"}], "dai:scope": {"@id": "ont:co_01M82B00W91390459HX0FJMY3T"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work allowed on Saturdays 09:00-12:00"},
    {"@id": "ont:ru_01M82B7AD49EHMKTM1WFJFM31C", "@type": "dai:Rule", "dai:action": "announce a move to the house management", "dai:actor": "resident", "dai:condition": "when moving", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": ">=", "dai:limitUnit": "days in advance", "dai:limitValue": {"@type": "xsd:decimal", "@value": "7.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QT"}, {"@id": "ont:cn_01M82B0RVQB8E3F7FG9YPD26J7"}, {"@id": "ont:rl_01M82B7AD49EHMKTM1WFJFM318"}], "dai:scope": {"@id": "ont:co_01M82B00W91390459HX0FJMY3T"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Announce a move at least 7 days in advance"},
    {"@id": "ont:ru_01M82B7AD49EHMKTM1WFJFM31D", "@type": "dai:Rule", "dai:action": "protect the lift with the covers provided", "dai:actor": "resident", "dai:condition": "during a move", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QT"}, {"@id": "ont:cn_01M82B3MD8NCJFJC9394MZ8MQS"}, {"@id": "ont:cn_01M82B7AD49EHMKTM1WFJFM317"}, {"@id": "ont:rl_01M82B7AD49EHMKTM1WFJFM319"}], "dai:scope": {"@id": "ont:co_01M82B00W91390459HX0FJMY3T"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Protect the lift with the covers provided"},
    {"@id": "ont:ru_01M82B7SZH0HB7CYPRM3TFNXNC", "@type": "dai:Rule", "dai:action": "report damage, noise complaints and rule violations to the house management in writing", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBE"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AM9P6EWS5D1VJCAH8Z7VF"}, {"@id": "ont:cn_01M82B0RVQB8E3F7FG9YPD26J7"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXMZ"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN1"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN2"}, {"@id": "ont:rl_01M82B7SZH0HB7CYPRM3TFNXN6"}, {"@id": "ont:rl_01M82B7SZH0HB7CYPRM3TFNXN7"}, {"@id": "ont:rl_01M82B7SZH0HB7CYPRM3TFNXN8"}], "dai:scope": {"@id": "ont:co_01M82B00W91390459HX0FJMY3T"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Report damage, noise and violations in writing"},
    {"@id": "ont:ru_01M82B7SZH0HB7CYPRM3TFNXND", "@type": "dai:Rule", "dai:action": "terminate the tenancy", "dai:actor": "house management", "dai:condition": "repeated violations after a written warning", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBE"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82B0RVQB8E3F7FG9YPD26J7"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN2"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN3"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN4"}, {"@id": "ont:cn_01M82B7SZH0HB7CYPRM3TFNXN5"}, {"@id": "ont:rl_01M82B7SZH0HB7CYPRM3TFNXN9"}, {"@id": "ont:rl_01M82B7SZH0HB7CYPRM3TFNXNB"}], "dai:scope": {"@id": "ont:co_01M82B00W91390459HX0FJMY3T"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Repeated violations may lead to termination"},
    {"@id": "ont:st_01M82AC66KMJH32E2MQ3Z7ZBK7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB8"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog lives 10 to 15 years."},
    {"@id": "ont:st_01M82AC66KMJH32E2MQ3Z7ZBK8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB8"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog needs daily exercise, company, training and veterinary care for its whole life."},
    {"@id": "ont:st_01M82AC66KMJH32E2MQ3Z7ZBK9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB8"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Before you get a dog, check that your home, your working hours and your budget fit the dog you want."},
    {"@id": "ont:st_01M82AC66KMJH32E2MQ3Z7ZBKA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB9"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog older than 4 months must be registered with the local authority."},
    {"@id": "ont:st_01M82AC66KMJH32E2MQ3Z7ZBKB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB9"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog older than 4 months must carry a microchip."},
    {"@id": "ont:st_01M82ACZDMSZ5RR2QTW9X92PB7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBB"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Breeds differ in size, energy and the care they need."},
    {"@id": "ont:st_01M82ACZDNRYXG7FZCA8KC7FCD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBC"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Small companion breeds need less space and less exercise and adapt well to flats."},
    {"@id": "ont:st_01M82ACZDNRYXG7FZCA8KC7FCE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Large and working breeds need more space, more exercise and more mental work."},
    {"@id": "ont:st_01M82ACZDNRYXG7FZCA8KC7FCF", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired breeds need more grooming than short-haired breeds."},
    {"@id": "ont:st_01M82ACZDNRYXG7FZCA8KC7FCG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBF"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Some breeds are classified as dangerous by the local authority."},
    {"@id": "ont:st_01M82ACZDNRYXG7FZCA8KC7FCH", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBF"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Check the local list of dangerous breeds before you choose a breed."},
    {"@id": "ont:st_01M82ADJQKNCFSCKCDMA3H0R7R", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBH"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog is fed twice a day."},
    {"@id": "ont:st_01M82ADJQKNCFSCKCDMA3H0R7S", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBH"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy is fed three to four times a day."},
    {"@id": "ont:st_01M82ADJQKNCFSCKCDMA3H0R7T", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBH"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Fresh water must always be available."},
    {"@id": "ont:st_01M82ADJQKNCFSCKCDMA3H0R7V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBH"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Chocolate, grapes, onions and xylitol are poisonous to dogs."},
    {"@id": "ont:st_01M82AE56ZYS5Y2Z0C35ECC9Y2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBK"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy receives its first vaccinations at 8 weeks of age."},
    {"@id": "ont:st_01M82AE56ZYS5Y2Z0C35ECC9Y3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination is mandatory."},
    {"@id": "ont:st_01M82AE56ZYS5Y2Z0C35ECC9Y4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination must be renewed every year."},
    {"@id": "ont:st_01M82AE56ZYS5Y2Z0C35ECC9Y5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner must take the dog to the veterinarian for a check-up at least once a year."},
    {"@id": "ont:st_01M82AEQW4JVCNX0WEDNNR61VN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog should be brushed at least once a week."},
    {"@id": "ont:st_01M82AEQW4JVCNX0WEDNNR61VP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired breeds need brushing every day."},
    {"@id": "ont:st_01M82AEQW4JVCNX0WEDNNR61VQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Trim the dog's claws when you can hear them clicking on the floor."},
    {"@id": "ont:st_01M82AEQW4JVCNX0WEDNNR61VR", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Wash the dog's bed and blankets once a week at 60 °C."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10J7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZ9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy is a dog younger than 6 months."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10J8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZ9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Puppies should not leave their mother before 8 weeks of age."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10J9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZA"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "House training of a puppy starts on the first day."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10JA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZA"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "During house training, the puppy is taken outside after every meal, after every nap and after play."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10JB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZA"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The puppy is praised when it relieves itself outside."},
    {"@id": "ont:st_01M82AF7YTEGBGGS9B245D10JC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZA"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Between 8 and 16 weeks, the puppy should get to know many people, sounds, surfaces and traffic in a calm way."},
    {"@id": "ont:st_01M82AFTZDSHCD0SK6T4N2YZVW", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZC"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A leash of 1.5 to 2 metres should be used for everyday walks."},
    {"@id": "ont:st_01M82AFTZDSHCD0SK6T4N2YZVX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZC"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A retractable leash is not suitable in busy streets."},
    {"@id": "ont:st_01M82AFTZDSHCD0SK6T4N2YZVY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZC"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The leash is attached to a well-fitting collar or harness."},
    {"@id": "ont:st_01M82AFTZDSHCD0SK6T4N2YZVZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZC"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "You should be able to slide two fingers under the collar."},
    {"@id": "ont:st_01M82AG9DZ4Q7M3Z8RX016AKWA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Leash training starts when the puppy is 8 to 10 weeks old."},
    {"@id": "ont:st_01M82AG9DZ4Q7M3Z8RX016AKWB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The dog is rewarded when the leash is loose."},
    {"@id": "ont:st_01M82AG9DZ4Q7M3Z8RX016AKWC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The walk is stopped when the dog pulls."},
    {"@id": "ont:st_01M82AG9DZ4Q7M3Z8RX016AKWD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The leash is never jerked."},
    {"@id": "ont:st_01M82AH1GXVV72WP99JQXMH6X5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog needs at least two walks a day."},
    {"@id": "ont:st_01M82AH1GXVV72WP99JQXMH6X6", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Small breeds need 30 to 60 minutes of walking a day in total."},
    {"@id": "ont:st_01M82AH1GXVV72WP99JQXMH6X7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Large and working breeds need up to 2 hours of walking a day."},
    {"@id": "ont:st_01M82AH1GXVV72WP99JQXMH6X8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy must be taken outside to relieve itself every 2 to 3 hours."},
    {"@id": "ont:st_01M82AH1GXVV72WP99JQXMH6X9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner must always pick up the dog's waste and put it in a waste bin."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog looks to its owner for direction."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner should be the dog's lead: a calm, consistent and confident leader whose signals the dog can trust."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The same command words should be used every time, and everyone in the family should use them too."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KME", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZM"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner should set clear rules for the dog, such as whether it may lie on the sofa, and keep them."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMF", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Good behaviour should be rewarded immediately."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Unwanted behaviour should be ignored instead of shouting."},
    {"@id": "ont:st_01M82AHPS6SQKW9E9EPJYC3KMH", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZP"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog that does not see its owner as a reliable lead may become anxious or try to take control."},
    {"@id": "ont:st_01M82AJ8HWH90DHFSC2JB20DFP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZR"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every dog should learn five basic commands: sit, down, stay, come and leave it."},
    {"@id": "ont:st_01M82AJ8HWH90DHFSC2JB20DFQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZR"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Training is done in short sessions of 5 to 10 minutes, several times a day."},
    {"@id": "ont:st_01M82AJ8HWH90DHFSC2JB20DFR", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZR"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A training session should always end with a success."},
    {"@id": "ont:st_01M82AJ8HWH90DHFSC2JB20DFS", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZS"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog training course with a certified trainer is recommended in the first year."},
    {"@id": "ont:st_01M82AJ8HWH90DHFSC2JB20DFT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs of breeds classified as dangerous must pass an obedience test."},
    {"@id": "ont:st_01M82AK1Z8YRQBGAGXAECRMD6B", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX2"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs are social animals."},
    {"@id": "ont:st_01M82AK1Z8YRQBGAGXAECRMD6C", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX2"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog must never be left alone at home for more than 6 hours."},
    {"@id": "ont:st_01M82AK1Z8YRQBGAGXAECRMD6D", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX2"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Puppies should not be left alone for more than 2 hours."},
    {"@id": "ont:st_01M82AK1Z8YRQBGAGXAECRMD6E", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Before leaving, the owner should walk the dog, leave water and a safe chew toy, and keep the departure low-key."},
    {"@id": "ont:st_01M82AK1Z8YRQBGAGXAECRMD6F", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX3"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "If a dog barks or howls while the owner is away, the owner should train it to be alone step by step, starting with a few minutes."},
    {"@id": "ont:st_01M82AKNKGVB3WQ6AJ3QXNT51Q", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX5"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "In a car, a dog must travel in a crate or wear a safety harness attached to the seat belt."},
    {"@id": "ont:st_01M82AKNKGVB3WQ6AJ3QXNT51R", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX5"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog must never be left in a parked car in warm weather."},
    {"@id": "ont:st_01M82AKNKGVB3WQ6AJ3QXNT51S", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX5"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "For travel abroad, a dog needs a pet passport, a microchip and a valid rabies vaccination."},
    {"@id": "ont:st_01M82AM9P5HMXJKJ1997DWSW20", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX7"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The dog owner is liable for any damage the dog causes."},
    {"@id": "ont:st_01M82AM9P5HMXJKJ1997DWSW21", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Third-party liability insurance for dog owners is strongly recommended."},
    {"@id": "ont:st_01M82AM9P6EWS5D1VJCAH8Z7TX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX7"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Third-party liability insurance is mandatory for breeds classified as dangerous by the local authority."},
    {"@id": "ont:st_01M82AM9P6EWS5D1VJCAH8Z7TY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX7"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "In public places, a dog must be kept on a leash unless a sign allows free running."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7T", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat lives 12 to 18 years."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats are independent."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7W", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats need daily attention, play and a clean environment."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7X", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for food and litter."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7Y", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for yearly veterinary visits."},
    {"@id": "ont:st_01M82AQDR2NPZDR8C737517K7Z", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for someone to look after the cat when they travel."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARJ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWM"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat owner should decide early whether the cat will be an indoor cat or an outdoor cat."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARK", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An indoor cat never leaves the flat."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARM", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "On average an indoor cat lives longer."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An indoor cat needs more play and climbing places."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWP"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An outdoor cat goes outside on its own."},
    {"@id": "ont:st_01M82AR3FY4ER2X3BN6TNX7ARQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWP"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An outdoor cat must be vaccinated and microchipped before it goes outside for the first time."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C28", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a litter box."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C29", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a scratching post."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C2A", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs food and water bowls."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C2B", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat's food and water bowls are placed away from the litter box."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C2C", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a quiet place to sleep."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C2D", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Windows and balconies are to be secured with a net."},
    {"@id": "ont:st_01M82ARW4GRHWZH2QAVQ4Z6C2E", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats can fall from height."},
    {"@id": "ont:st_01M82ASKHFBYSNYN4MRYSFQKXG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult cat should be fed two to three small meals a day."},
    {"@id": "ont:st_01M82ASKHG81R2G0W9373Z4V7Z", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens need four meals a day."},
    {"@id": "ont:st_01M82ASKHG81R2G0W9373Z4V80", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats need meat-based food."},
    {"@id": "ont:st_01M82ASKHG81R2G0W9373Z4V81", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lilies, onions, chocolate and dog food are not suitable for cats."},
    {"@id": "ont:st_01M82ASKHG81R2G0W9373Z4V82", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lilies are highly poisonous to cats."},
    {"@id": "ont:st_01M82AT58GVN9GHPNG420CQGD6", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A kitten receives its first vaccinations at 8 weeks of age."},
    {"@id": "ont:st_01M82AT58GVN9GHPNG420CQGD7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that goes outdoors must also be vaccinated against rabies."},
    {"@id": "ont:st_01M82AT58GVN9GHPNG420CQGD8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination of an outdoor cat is renewed every year."},
    {"@id": "ont:st_01M82AT58GVN9GHPNG420CQGD9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat should be neutered at about 5 to 6 months of age."},
    {"@id": "ont:st_01M82AT58GVN9GHPNG420CQGDA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The pet should visit the veterinarian at least once a year."},
    {"@id": "ont:st_01M82ATVV0G4J5RJ6TZ063RNY7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2W"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An owner provides one litter box per cat plus one extra."},
    {"@id": "ont:st_01M82ATVV0G4J5RJ6TZ063RNY8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2W"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Clumps are removed from the litter box every day."},
    {"@id": "ont:st_01M82ATVV0G4J5RJ6TZ063RNY9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2W"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "All litter in the litter box is replaced once a week."},
    {"@id": "ont:st_01M82ATVV0G4J5RJ6TZ063RNYA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2W"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Used litter goes into the residual waste, never into the toilet or the compost."},
    {"@id": "ont:st_01M82AVB4Q3YP83EB2BM9CVNGZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A kitten is a cat younger than 6 months."},
    {"@id": "ont:st_01M82AVB4Q3YP83EB2BM9CVNH0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens should not leave their mother before 12 weeks of age."},
    {"@id": "ont:st_01M82AVB4Q3YP83EB2BM9CVNH1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A new kitten should explore one room first, then the rest of the flat."},
    {"@id": "ont:st_01M82AVB4Q3YP83EB2BM9CVNH2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens learn to use the litter box quickly if it is easy to reach."},
    {"@id": "ont:st_01M82AVWYQTEWX0BYTM82R4873", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H30"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Play with your cat for at least 15 minutes twice a day."},
    {"@id": "ont:st_01M82AVWYQTEWX0BYTM82R4874", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H30"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that scratches furniture usually needs a better scratching post, not punishment."},
    {"@id": "ont:st_01M82AVWYQTEWX0BYTM82R4875", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H30"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Never punish a cat physically."},
    {"@id": "ont:st_01M82AVWYQTEWX0BYTM82R4876", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H30"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that suddenly stops using its litter box may be ill and should see a veterinarian."},
    {"@id": "ont:st_01M82AWHX95SVMSNEZPEX87TRB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Short-haired cats groom themselves."},
    {"@id": "ont:st_01M82AWHX95SVMSNEZPEX87TRC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Short-haired cats should be brushed once a week to reduce hair in the flat."},
    {"@id": "ont:st_01M82AWHX95SVMSNEZPEX87TRD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired cats need brushing every day to prevent matting."},
    {"@id": "ont:st_01M82AWHX95SVMSNEZPEX87TRE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat should not be bathed unless the veterinarian advises it."},
    {"@id": "ont:st_01M82AX2AYWV44F1MEHFVJNNFG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H34"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult cat can stay alone for up to 24 hours if it has enough food, fresh water and a clean litter box."},
    {"@id": "ont:st_01M82AX2AYWV44F1MEHFVJNNFH", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H34"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "For absences longer than 24 hours, someone must be arranged to visit the cat at least once a day."},
    {"@id": "ont:st_01M82AXJ1250JDQ3F0HM8ET4QC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats are attached to their territory."},
    {"@id": "ont:st_01M82AXJ1250JDQ3F0HM8ET4QD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "On moving day, the cat is kept in a closed room with its litter box."},
    {"@id": "ont:st_01M82AXJ1250JDQ3F0HM8ET4QE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "After the move, an outdoor cat is kept indoors for at least 2 weeks before it is let outside, so that it learns its new home."},
    {"@id": "ont:st_01M82B0RVQB8E3F7FG9YPD26HS", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "These rules apply to buildings A, B and C around the shared inner yard."},
    {"@id": "ont:st_01M82B0RVQB8E3F7FG9YPD26HT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A resident is anyone who lives in one of the buildings: tenants, owners and their household members."},
    {"@id": "ont:st_01M82B0RVQB8E3F7FG9YPD26HV", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The house management administers the buildings."},
    {"@id": "ont:st_01M82B0RVQB8E3F7FG9YPD26HW", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The house management enforces these rules."},
    {"@id": "ont:st_01M82B0RVQB8E3F7FG9YPD26HX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every resident must follow these rules."},
    {"@id": "ont:st_01M82B1AN7D1ZA7ABBS5RZ4XJT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KQ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Quiet hours are from 22:00 to 07:00 on weekdays."},
    {"@id": "ont:st_01M82B1AN7D1ZA7ABBS5RZ4XJV", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KQ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Quiet hours are from 22:00 to 09:00 on weekends and public holidays."},
    {"@id": "ont:st_01M82B1AN7D1ZA7ABBS5RZ4XJW", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KQ"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "During quiet hours, residents must avoid noise that can be heard in other flats or in the inner yard."},
    {"@id": "ont:st_01M82B1AN7D1ZA7ABBS5RZ4XJX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KQ"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noise to be avoided during quiet hours includes music, drilling and persistent barking."},
    {"@id": "ont:st_01M82B273V2ZBJ1A5ME4ECN7T8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The inner yard is shared by all residents."},
    {"@id": "ont:st_01M82B273V2ZBJ1A5ME4ECN7T9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Children may play in the inner yard between 08:00 and 20:00."},
    {"@id": "ont:st_01M82B273V2ZBJ1A5ME4ECN7TA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Bicycles must be parked in the bicycle racks only."},
    {"@id": "ont:st_01M82B273V2ZBJ1A5ME4ECN7TB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Barbecues are allowed only in the marked barbecue area."},
    {"@id": "ont:st_01M82B273V2ZBJ1A5ME4ECN7TC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Barbecues are never allowed during quiet hours."},
    {"@id": "ont:st_01M82B2PPZPYF6543TD3RQQKN8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EA"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every pet (dog or cat) must be registered with the house management."},
    {"@id": "ont:st_01M82B2PPZPYF6543TD3RQQKN9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EA"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A pet must be registered within 14 days of moving in or acquiring the pet."},
    {"@id": "ont:st_01M82B2PPZPYF6543TD3RQQKNA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EA"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A pet owner must make sure that their pet does not disturb other residents."},
    {"@id": "ont:st_01M82B3MD77GTCF7Q7S02RS3Q4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EC"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs must be kept on a lead at all times in the inner yard, the stairwells and the lifts."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MPZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EC"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The lead may not be longer than 2 metres."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MQ0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ED"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs may not relieve themselves in the inner yard or the flower beds."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MQ1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ED"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dog owners take their dogs outside the building complex to relieve themselves."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MQ2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The maximum time a dog may be left alone in a flat depends on the dog's training and its specific breed."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MQ3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Owners are responsible for knowing the alone-time limit that applies to their dog."},
    {"@id": "ont:st_01M82B3MD8NCJFJC9394MZ8MQ4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EF"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "If a dog barks persistently while left alone, the house management may require the owner to arrange care."},
    {"@id": "ont:st_01M82B441E6BBHH3GXQY9DWSBS", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EH"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats may move freely in the inner yard."},
    {"@id": "ont:st_01M82B441E6BBHH3GXQY9DWSBT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EH"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats may not be kept in the stairwells or the cellar."},
    {"@id": "ont:st_01M82B441E6BBHH3GXQY9DWSBV", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EH"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Litter boxes must be kept inside the flat."},
    {"@id": "ont:st_01M82B4TJPFJR5BJ36WDBJSZZE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Waste is sorted in the bin room of building B into paper, plastic, glass, organic waste and residual waste."},
    {"@id": "ont:st_01M82B4TJPFJR5BJ36WDBJSZZF", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EK"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Pet waste and used cat litter go into the residual waste bin only."},
    {"@id": "ont:st_01M82B4TJPFJR5BJ36WDBJSZZG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EK"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Bulky items must be booked for collection with the house management."},
    {"@id": "ont:st_01M82B5BJWECFNN10MNRT4KBXB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Stairwells, corridors and escape routes must be kept free of objects."},
    {"@id": "ont:st_01M82B5BJWECFNN10MNRT4KBXC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The objects that must not be left in stairwells, corridors and escape routes include prams, shoes and pet equipment."},
    {"@id": "ont:st_01M82B5BJWECFNN10MNRT4KBXD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EN"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Smoking is not allowed in any shared indoor space."},
    {"@id": "ont:st_01M82B5VQ6AQJZT0DHJWAXTBQQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EQ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The main doors of each building stay closed and locked from 22:00 to 06:00."},
    {"@id": "ont:st_01M82B5VQ6AQJZT0DHJWAXTBQR", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EQ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Residents open the main doors with their own key."},
    {"@id": "ont:st_01M82B5VQ6AQJZT0DHJWAXTBQS", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EQ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Residents must not let strangers into the building."},
    {"@id": "ont:st_01M82B5VQ6AQJZT0DHJWAXTBQT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EQ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lost keys must be reported to the house management at once."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHN8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The shared laundry room is in the cellar of building A."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHN9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The shared laundry room may be used from 07:00 to 21:00."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHNA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A slot for the laundry room is booked on the list at the door."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHNB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Pet blankets, pet beds and other pet textiles may not be washed in the shared washing machines."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHNC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Each flat has one cellar compartment."},
    {"@id": "ont:st_01M82B6NEKKV0CSECXDQRKNHND", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Flammable liquids may not be stored in the cellar compartment."},
    {"@id": "ont:st_01M82B7AD49EHMKTM1WFJFM30R", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work such as drilling is allowed on weekdays from 08:00 to 12:00 and from 14:00 to 18:00."},
    {"@id": "ont:st_01M82B7AD49EHMKTM1WFJFM30S", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work such as drilling is allowed on Saturdays from 09:00 to 12:00."},
    {"@id": "ont:st_01M82B7AD49EHMKTM1WFJFM30T", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A move must be announced to the house management at least 7 days in advance."},
    {"@id": "ont:st_01M82B7AD49EHMKTM1WFJFM30V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "During a move the lift must be protected with the covers provided."},
    {"@id": "ont:st_01M82B7SZH0HB7CYPRM3TFNXMN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBE"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Damage, noise complaints and rule violations are reported to the house management in writing."},
    {"@id": "ont:st_01M82B7SZH0HB7CYPRM3TFNXMP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBE"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Repeated violations after a written warning may lead to termination of the tenancy."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB8", "@type": "dai:SourceUnit", "rdfs:label": "A dog lives 10 to 15 years. It needs daily exercise, company, training and veterinary care for its whole life. Before you get a dog, check that your home, your working hours and your budget fit the dog you want."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHB9", "@type": "dai:SourceUnit", "rdfs:label": "A dog older than 4 months must be registered with the local authority and must carry a microchip."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBB", "@type": "dai:SourceUnit", "rdfs:label": "Breeds differ in size, energy and the care they need."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBC", "@type": "dai:SourceUnit", "rdfs:label": "**Small companion breeds** (for example, Maltese or Pug) need less space and less exercise and adapt well to flats."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBD", "@type": "dai:SourceUnit", "rdfs:label": "**Large and working breeds** (for example, Border Collie or German Shepherd) need more space, more exercise and more mental work."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBE", "@type": "dai:SourceUnit", "rdfs:label": "**Long-haired breeds** need more grooming than short-haired breeds."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBF", "@type": "dai:SourceUnit", "rdfs:label": "Some breeds are classified as dangerous by the local authority. Check the local list before you choose a breed."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBH", "@type": "dai:SourceUnit", "rdfs:label": "Feed an adult dog twice a day and a puppy three to four times a day. Fresh water must always be available. Chocolate, grapes, onions and xylitol are poisonous to dogs."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBK", "@type": "dai:SourceUnit", "rdfs:label": "A puppy receives its first vaccinations at 8 weeks of age. The rabies vaccination is mandatory and must be renewed every year. Take your dog to the veterinarian for a check-up at least once a year."},
    {"@id": "ont:su_01M82ABDR1CAX5PFZ2HWSEQHBN", "@type": "dai:SourceUnit", "rdfs:label": "Brush your dog at least once a week; long-haired breeds need brushing every day. Trim the claws when you can hear them clicking on the floor. Wash your dog's bed and blankets once a week at 60 °C."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZ9", "@type": "dai:SourceUnit", "rdfs:label": "A puppy is a dog younger than 6 months. Puppies should not leave their mother before 8 weeks of age."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZA", "@type": "dai:SourceUnit", "rdfs:label": "House training starts on the first day: take the puppy outside after every meal, after every nap and after play, and praise it when it relieves itself outside. Between 8 and 16 weeks, let the puppy get to know many people, sounds, surfaces and traffic in a calm way."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZC", "@type": "dai:SourceUnit", "rdfs:label": "Use a leash of 1.5 to 2 metres for everyday walks. A retractable leash is not suitable in busy streets. Attach the leash to a well-fitting collar or harness: you should be able to slide two fingers under the collar."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE", "@type": "dai:SourceUnit", "rdfs:label": "Start leash training when the puppy is 8 to 10 weeks old. Reward the dog when the leash is loose, and stop walking when the dog pulls. Never jerk the leash."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG", "@type": "dai:SourceUnit", "rdfs:label": "An adult dog needs at least two walks a day: 30 to 60 minutes in total for small breeds and up to 2 hours for large and working breeds. A puppy must be taken outside to relieve itself every 2 to 3 hours. Always pick up your dog's waste and put it in a waste bin."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZJ", "@type": "dai:SourceUnit", "rdfs:label": "Your dog looks to you for direction. Be its lead: a calm, consistent and confident leader whose signals it can trust."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZK", "@type": "dai:SourceUnit", "rdfs:label": "Use the same command words every time, and make sure everyone in the family uses them too."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZM", "@type": "dai:SourceUnit", "rdfs:label": "Set clear rules (for example, whether the dog may lie on the sofa) and keep them."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZN", "@type": "dai:SourceUnit", "rdfs:label": "Reward good behaviour immediately; ignore unwanted behaviour instead of shouting."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZP", "@type": "dai:SourceUnit", "rdfs:label": "A dog that does not see its owner as a reliable lead may become anxious or try to take control."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZR", "@type": "dai:SourceUnit", "rdfs:label": "Every dog should learn five basic commands: *sit*, *down*, *stay*, *come* and *leave it*. Train in short sessions of 5 to 10 minutes, several times a day, and always end with a success."},
    {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZS", "@type": "dai:SourceUnit", "rdfs:label": "A dog training course with a certified trainer is recommended in the first year. Dogs of breeds classified as dangerous must pass an obedience test."},
    {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX2", "@type": "dai:SourceUnit", "rdfs:label": "Dogs are social animals. **Never leave an adult dog alone at home for more than 6 hours.** Puppies should not be left alone for more than 2 hours."},
    {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX3", "@type": "dai:SourceUnit", "rdfs:label": "Before you leave, walk the dog, leave water and a safe chew toy, and keep your departure low-key. If your dog barks or howls while you are away, train it to be alone step by step, starting with a few minutes."},
    {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX5", "@type": "dai:SourceUnit", "rdfs:label": "In a car, a dog must travel in a crate or wear a safety harness attached to the seat belt. Never leave a dog in a parked car in warm weather. For travel abroad, your dog needs a pet passport, a microchip and a valid rabies vaccination."},
    {"@id": "ont:su_01M82ABDR30PE47ZK8WSGY3HX7", "@type": "dai:SourceUnit", "rdfs:label": "You are liable for any damage your dog causes. Third-party liability insurance for dog owners is strongly recommended, and it is mandatory for breeds classified as dangerous by the local authority. In public places, your dog must be kept on a leash unless a sign allows free running."},
    {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWJ", "@type": "dai:SourceUnit", "rdfs:label": "A cat lives 12 to 18 years. Cats are independent, but they still need daily attention, play and a clean environment. Plan for food, litter, yearly veterinary visits and someone to look after the cat when you travel."},
    {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWM", "@type": "dai:SourceUnit", "rdfs:label": "Decide early whether your cat will be an indoor cat or an outdoor cat."},
    {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWN", "@type": "dai:SourceUnit", "rdfs:label": "An **indoor cat** never leaves the flat. On average it lives longer, but it needs more play and climbing places."},
    {"@id": "ont:su_01M82APMQ68JDJRTYQDVNXFWWP", "@type": "dai:SourceUnit", "rdfs:label": "An **outdoor cat** goes outside on its own. It must be vaccinated and microchipped before it goes outside for the first time."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2P", "@type": "dai:SourceUnit", "rdfs:label": "Every cat needs a litter box, a scratching post, food and water bowls placed away from the litter box, and a quiet place to sleep. Secure windows and balconies with a net, because cats can fall from height."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2R", "@type": "dai:SourceUnit", "rdfs:label": "Feed an adult cat two to three small meals a day; kittens need four meals a day. Cats need meat-based food. Lilies, onions, chocolate and dog food are not suitable for cats; lilies are highly poisonous."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2T", "@type": "dai:SourceUnit", "rdfs:label": "A kitten receives its first vaccinations at 8 weeks of age. A cat that goes outdoors must also be vaccinated against rabies, renewed every year. Neuter your cat at about 5 to 6 months of age. Visit the veterinarian at least once a year."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2W", "@type": "dai:SourceUnit", "rdfs:label": "Provide one litter box per cat plus one extra. Remove clumps every day and replace all litter once a week. Used litter goes into the residual waste, never into the toilet or the compost."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y", "@type": "dai:SourceUnit", "rdfs:label": "A kitten is a cat younger than 6 months. Kittens should not leave their mother before 12 weeks of age. Let a new kitten explore one room first, then the rest of the flat. Kittens learn to use the litter box quickly if it is easy to reach."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H30", "@type": "dai:SourceUnit", "rdfs:label": "Play with your cat for at least 15 minutes twice a day. A cat that scratches furniture usually needs a better scratching post, not punishment. Never punish a cat physically. A cat that suddenly stops using its litter box may be ill and should see a veterinarian."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32", "@type": "dai:SourceUnit", "rdfs:label": "Short-haired cats groom themselves; brush them once a week to reduce hair in the flat. Long-haired cats need brushing every day to prevent matting. Do not bathe a cat unless the veterinarian advises it."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H34", "@type": "dai:SourceUnit", "rdfs:label": "An adult cat can stay alone for up to 24 hours if it has enough food, fresh water and a clean litter box. For longer absences, arrange for someone to visit the cat at least once a day."},
    {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36", "@type": "dai:SourceUnit", "rdfs:label": "Cats are attached to their territory. On moving day, keep the cat in a closed room with its litter box. After the move, keep an outdoor cat indoors for at least 2 weeks before you let it outside, so that it learns its new home."},
    {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KN", "@type": "dai:SourceUnit", "rdfs:label": "These rules apply to buildings A, B and C around the shared inner yard. A **resident** is anyone who lives in one of the buildings: tenants, owners and their household members. The **house management** administers the buildings and enforces these rules. Every resident must follow them."},
    {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KQ", "@type": "dai:SourceUnit", "rdfs:label": "Quiet hours are from 22:00 to 07:00 on weekdays and from 22:00 to 09:00 on weekends and public holidays. During quiet hours, residents must avoid noise that can be heard in other flats or in the inner yard, including music, drilling and persistent barking."},
    {"@id": "ont:su_01M82B00WAF2BQ321TGZ91X4KS", "@type": "dai:SourceUnit", "rdfs:label": "The inner yard is shared by all residents. Children may play there between 08:00 and 20:00. Bicycles must be parked in the bicycle racks only. Barbecues are allowed only in the marked barbecue area and never during quiet hours."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EA", "@type": "dai:SourceUnit", "rdfs:label": "Every pet (dog or cat) must be registered with the house management within 14 days of moving in or acquiring the pet. A pet owner must make sure that their pet does not disturb other residents."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EC", "@type": "dai:SourceUnit", "rdfs:label": "Dogs must be kept on a lead at all times in the inner yard, the stairwells and the lifts. The lead may not be longer than 2 metres."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ED", "@type": "dai:SourceUnit", "rdfs:label": "Dogs may not relieve themselves in the inner yard or the flower beds. Dog owners take their dogs outside the building complex for this."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EE", "@type": "dai:SourceUnit", "rdfs:label": "The maximum time a dog may be left alone in a flat depends on the dog's education (training) and its specific breed. Owners are responsible for knowing the limit that applies to their dog."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EF", "@type": "dai:SourceUnit", "rdfs:label": "If a dog barks persistently while left alone, the house management may require the owner to arrange care."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EH", "@type": "dai:SourceUnit", "rdfs:label": "Cats may move freely in the inner yard. Cats may not be kept in the stairwells or the cellar. Litter boxes must be kept inside the flat."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EK", "@type": "dai:SourceUnit", "rdfs:label": "Waste is sorted in the bin room of building B: paper, plastic, glass, organic waste and residual waste. Pet waste and used cat litter go into the residual waste bin only. Bulky items must be booked for collection with the house management."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EN", "@type": "dai:SourceUnit", "rdfs:label": "Stairwells, corridors and escape routes must be kept free of objects, including prams, shoes and pet equipment. Smoking is not allowed in any shared indoor space."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22EQ", "@type": "dai:SourceUnit", "rdfs:label": "The main doors of each building stay closed and locked from 22:00 to 06:00; residents open them with their own key. Do not let strangers into the building. Lost keys must be reported to the house management at once."},
    {"@id": "ont:su_01M82B00WB34E68SXWEMVZ22ES", "@type": "dai:SourceUnit", "rdfs:label": "The shared laundry room is in the cellar of building A and may be used from 07:00 to 21:00. Book a slot on the list at the door. Pet blankets, pet beds and other pet textiles may not be washed in the shared washing machines. Each flat has one cellar compartment; flammable liquids may not be stored there."},
    {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBC", "@type": "dai:SourceUnit", "rdfs:label": "Noisy work such as drilling is allowed on weekdays from 08:00 to 12:00 and from 14:00 to 18:00, and on Saturdays from 09:00 to 12:00. Announce a move to the house management at least 7 days in advance, and protect the lift with the covers provided."},
    {"@id": "ont:su_01M82B00WCXHEC1FCHYNF4GYBE", "@type": "dai:SourceUnit", "rdfs:label": "Report damage, noise complaints and rule violations to the house management in writing. Repeated violations after a written warning may lead to termination of the tenancy."},
    {"@id": "urn:domain-ai-assistant:ontology:pets-and-house-rules", "@type": "owl:Ontology", "dcterms:description": "Explain what it takes to own a dog or a cat in a residential complex, and which house rules apply to pets and their owners.", "owl:versionIRI": {"@id": "ont:version-raw+a71d110"}, "owl:versionInfo": "raw+a71d110"}
  ]
}
