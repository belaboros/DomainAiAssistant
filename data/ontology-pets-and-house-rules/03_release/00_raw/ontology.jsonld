    {"@id": "ont:ru_01M82HDB2GRFNRYQMSRVHKV6C2", "@type": "dai:Rule", "dai:action": "wash pet blankets, pet beds or other pet textiles in the shared washing machines", "dai:actor": "pet owner", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82HDB2F6BK5KDQ92WEFACHQ"}, {"@id": "ont:cn_01M82HDB2F6BK5KDQ92WEFACHR"}, {"@id": "ont:cn_01M82HDB2F6BK5KDQ92WEFACHS"}, {"@id": "ont:cn_01M82HDB2F6BK5KDQ92WEFACHT"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "No pet textiles in shared washing machines"},
