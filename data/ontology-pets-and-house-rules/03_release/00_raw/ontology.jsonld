    {"@id": "ont:ru_01M82AWHXAYC5J29RJ6Y82HD4A", "@type": "dai:Rule", "dai:action": "brush a short-haired cat once a week to reduce hair in the flat", "dai:actor": "cat owner", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "=", "dai:limitUnit": "times per week", "dai:limitValue": {"@type": "xsd:decimal", "@value": "1.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82ACZDNRYXG7FZCA8KC7FD5"}, {"@id": "ont:cn_01M82AEQW4JVCNX0WEDNNR61W1"}, {"@id": "ont:cn_01M82AWHXAYC5J29RJ6Y82HD3Y"}, {"@id": "ont:rl_01M82AWHXAYC5J29RJ6Y82HD48"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Brush short-haired cats once a week"},
    {"@id": "ont:ru_01M82AWHXAYC5J29RJ6Y82HD4B", "@type": "dai:Rule", "dai:action": "brush a long-haired cat every day to prevent matting", "dai:actor": "cat owner", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "=", "dai:limitUnit": "times per day", "dai:limitValue": {"@type": "xsd:decimal", "@value": "1.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AEQW4JVCNX0WEDNNR61W1"}, {"@id": "ont:cn_01M82AWHXAYC5J29RJ6Y82HD3Z"}, {"@id": "ont:cn_01M82AWHXAYC5J29RJ6Y82HD43"}, {"@id": "ont:rl_01M82AWHXAYC5J29RJ6Y82HD46"}, {"@id": "ont:rl_01M82AWHXAYC5J29RJ6Y82HD49"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Brush long-haired cats every day"},
    {"@id": "ont:ru_01M82AWHXAYC5J29RJ6Y82HD4C", "@type": "dai:Rule", "dai:action": "bathe a cat", "dai:actor": "cat owner", "dai:condition": "unless the veterinarian advises it", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H32"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9YB"}, {"@id": "ont:cn_01M82AQDR2NPZDR8C737517K86"}, {"@id": "ont:cn_01M82AWHXAYC5J29RJ6Y82HD42"}, {"@id": "ont:rl_01M82AWHXAYC5J29RJ6Y82HD47"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Do not bathe a cat without vet advice"},
    {"@id": "ont:ru_01M82AX2AYWV44F1MEHFVJNNG4", "@type": "dai:Rule", "dai:action": "leave an adult cat alone", "dai:actor": "owner", "dai:condition": "the cat has enough food, fresh water and a clean litter box", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H34"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "<=", "dai:limitUnit": "hours", "dai:limitValue": {"@type": "xsd:decimal", "@value": "24.0"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82ADJQKNCFSCKCDMA3H0R89"}, {"@id": "ont:cn_01M82AQDR2NPZDR8C737517K88"}, {"@id": "ont:cn_01M82ARW4GRHWZH2QAVQ4Z6C2S"}, {"@id": "ont:cn_01M82ASKHG81R2G0W9373Z4V8D"}, {"@id": "ont:rl_01M82AX2AYWV44F1MEHFVJNNG0"}, {"@id": "ont:rl_01M82AX2AYWV44F1MEHFVJNNG1"}, {"@id": "ont:rl_01M82AX2AYWV44F1MEHFVJNNG2"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Adult cat may stay alone up to 24 hours"},
    {"@id": "ont:ru_01M82AX2AYWV44F1MEHFVJNNG5", "@type": "dai:Rule", "dai:action": "arrange for someone to visit the cat at least once a day", "dai:actor": "owner", "dai:condition": "the absence is longer than 24 hours", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H34"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AQDR2NPZDR8C737517K86"}, {"@id": "ont:cn_01M82AX2AYWV44F1MEHFVJNNFY"}, {"@id": "ont:cn_01M82AX2AYWV44F1MEHFVJNNFZ"}, {"@id": "ont:rl_01M82AX2AYWV44F1MEHFVJNNG3"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Arrange daily visit for longer absences"},
    {"@id": "ont:ru_01M82AXJ1250JDQ3F0HM8ET4R3", "@type": "dai:Rule", "dai:action": "keep the cat in a closed room with its litter box", "dai:actor": "owner", "dai:condition": "on moving day", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AQDR2NPZDR8C737517K86"}, {"@id": "ont:cn_01M82ARW4GRHWZH2QAVQ4Z6C2S"}, {"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QV"}, {"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QX"}, {"@id": "ont:rl_01M82AXJ1250JDQ3F0HM8ET4R0"}, {"@id": "ont:rl_01M82AXJ1250JDQ3F0HM8ET4R1"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Keep cat in closed room with litter box on moving day"},
    {"@id": "ont:ru_01M82AXJ1250JDQ3F0HM8ET4R4", "@type": "dai:Rule", "dai:action": "keep the outdoor cat indoors before letting it outside, so that it learns its new home", "dai:actor": "owner", "dai:condition": "after the move", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H36"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": ">=", "dai:limitUnit": "weeks", "dai:limitValue": {"@type": "xsd:decimal", "@value": "2.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AR3FZSQYQ8M2V93VDTTRG"}, {"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QT"}, {"@id": "ont:cn_01M82AXJ1250JDQ3F0HM8ET4QY"}, {"@id": "ont:rl_01M82AXJ1250JDQ3F0HM8ET4R2"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Keep outdoor cat indoors at least 2 weeks after move"},
