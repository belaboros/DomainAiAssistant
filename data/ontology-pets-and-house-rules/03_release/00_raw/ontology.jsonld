    {"@id": "ont:ru_01M82AJ8HWH90DHFSC2JB20DG7", "@type": "dai:Rule", "dai:action": "learn the five basic commands sit, down, stay, come and leave it", "dai:actor": "dog", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZR"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AC66KMJH32E2MQ3Z7ZBKM"}, {"@id": "ont:cn_01M82AJ8HWH90DHFSC2JB20DFW"}, {"@id": "ont:rl_01M82AJ8HWH90DHFSC2JB20DG3"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dog should learn five basic commands"},
