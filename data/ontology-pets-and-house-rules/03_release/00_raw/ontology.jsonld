    {"@id": "ont:ru_01M82GJP3CRKNX3DNJZDNANDX1", "@type": "dai:Rule", "dai:action": "be registered with the local authority", "dai:actor": "dog", "dai:condition": "the dog is older than 4 months", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCF"}, "dai:level": {"@id": "dai:level-1"}, "dai:limitComparator": ">", "dai:limitUnit": "months", "dai:limitValue": {"@type": "xsd:decimal", "@value": "4.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GJP3CRKNX3DNJZDNANDWM"}, {"@id": "ont:cn_01M82GJP3CRKNX3DNJZDNANDWN"}, {"@id": "ont:rl_01M82GJP3CRKNX3DNJZDNANDWV"}], "dai:scope": {"@id": "ont:co_01M82GHYMN49VHXB6YMXXC893Z"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs older than 4 months must be registered"},
    {"@id": "ont:ru_01M82GJP3CRKNX3DNJZDNANDX2", "@type": "dai:Rule", "dai:action": "carry a microchip", "dai:actor": "dog", "dai:condition": "the dog is older than 4 months", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCF"}, "dai:level": {"@id": "dai:level-1"}, "dai:limitComparator": ">", "dai:limitUnit": "months", "dai:limitValue": {"@type": "xsd:decimal", "@value": "4.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GJP3CRKNX3DNJZDNANDWM"}, {"@id": "ont:cn_01M82GJP3CRKNX3DNJZDNANDWP"}, {"@id": "ont:rl_01M82GJP3CRKNX3DNJZDNANDWW"}], "dai:scope": {"@id": "ont:co_01M82GHYMN49VHXB6YMXXC893Z"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs older than 4 months must carry a microchip"},
