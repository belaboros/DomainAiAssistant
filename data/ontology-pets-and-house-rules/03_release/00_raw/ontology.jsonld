    {"@id": "ont:ru_01M82H22REK3TH3893EQK4YE11", "@type": "dai:Rule", "dai:action": "leave its mother", "dai:actor": "kitten", "dai:condition": "before 12 weeks of age", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": "<", "dai:limitUnit": "weeks", "dai:limitValue": {"@type": "xsd:decimal", "@value": "12.0"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82H22REK3TH3893EQK4YE0S"}, {"@id": "ont:cn_01M82H22REK3TH3893EQK4YE0V"}, {"@id": "ont:rl_01M82H22REK3TH3893EQK4YE0Y"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kitten stays with mother until 12 weeks"},
    {"@id": "ont:ru_01M82H22REK3TH3893EQK4YE12", "@type": "dai:Rule", "dai:action": "let a new kitten explore one room first, then the rest of the flat", "dai:actor": "owner", "dai:condition": "when a new kitten arrives", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GKFJ96730WAHGQQD3M95G"}, {"@id": "ont:cn_01M82H22REK3TH3893EQK4YE0S"}, {"@id": "ont:rl_01M82H22REK3TH3893EQK4YE10"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "New kitten explores one room first"},
    {"@id": "ont:ru_01M82H2KZE881EPDPP32PV6RGN", "@type": "dai:Rule", "dai:action": "play with the cat for at least 15 minutes, twice a day", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": ">=", "dai:limitUnit": "minutes", "dai:limitValue": {"@type": "xsd:decimal", "@value": "15.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F2"}, {"@id": "ont:cn_01M82H2KZE881EPDPP32PV6RGF"}, {"@id": "ont:rl_01M82H2KZE881EPDPP32PV6RGG"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Play with cat at least 15 minutes twice a day"},
    {"@id": "ont:ru_01M82H2KZE881EPDPP32PV6RGP", "@type": "dai:Rule", "dai:action": "punish a cat physically", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F2"}, {"@id": "ont:cn_01M82H2KZE881EPDPP32PV6RGE"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Never punish a cat physically"},
    {"@id": "ont:ru_01M82H2KZE881EPDPP32PV6RGQ", "@type": "dai:Rule", "dai:action": "take the cat to a veterinarian", "dai:actor": "owner", "dai:condition": "the cat suddenly stops using its litter box", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GMKV1KS5PBE1QB2P99CPC"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F2"}, {"@id": "ont:cn_01M82GZMM3VP80T7XD6GS67TSK"}, {"@id": "ont:rl_01M82H2KZE881EPDPP32PV6RGK"}, {"@id": "ont:rl_01M82H2KZE881EPDPP32PV6RGM"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cat avoiding litter box should see a veterinarian"},
    {"@id": "ont:ru_01M82H394WWKSMY0HG5WFCNGAN", "@type": "dai:Rule", "dai:action": "brush a short-haired cat once a week to reduce hair in the flat", "dai:actor": "cat owner", "dai:condition": "the cat is short-haired", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "=", "dai:limitUnit": "times per week", "dai:limitValue": {"@type": "xsd:decimal", "@value": "1.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GKFJ96730WAHGQQD3M95G"}, {"@id": "ont:cn_01M82GN67QTV2KDH6NRHKR2RZZ"}, {"@id": "ont:cn_01M82H394WWKSMY0HG5WFCNGA8"}, {"@id": "ont:rl_01M82H394WWKSMY0HG5WFCNGAH"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Brush short-haired cats once a week"},
    {"@id": "ont:ru_01M82H394WWKSMY0HG5WFCNGAP", "@type": "dai:Rule", "dai:action": "brush a long-haired cat every day to prevent matting", "dai:actor": "cat owner", "dai:condition": "the cat is long-haired", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "=", "dai:limitUnit": "times per day", "dai:limitValue": {"@type": "xsd:decimal", "@value": "1.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GN67QTV2KDH6NRHKR2RZZ"}, {"@id": "ont:cn_01M82H394WWKSMY0HG5WFCNGA9"}, {"@id": "ont:cn_01M82H394WWKSMY0HG5WFCNGAE"}, {"@id": "ont:rl_01M82H394WWKSMY0HG5WFCNGAJ"}, {"@id": "ont:rl_01M82H394WWKSMY0HG5WFCNGAK"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Brush long-haired cats every day"},
    {"@id": "ont:ru_01M82H394WWKSMY0HG5WFCNGAQ", "@type": "dai:Rule", "dai:action": "bathe a cat", "dai:actor": "cat owner", "dai:condition": "unless the veterinarian advises it", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82GMKV1KS5PBE1QB2P99CPC"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82H394WWKSMY0HG5WFCNGAC"}, {"@id": "ont:rl_01M82H394WWKSMY0HG5WFCNGAM"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Do not bathe a cat without vet advice"},
    {"@id": "ont:ru_01M82H3S04Z53GFAPY01PTT04D", "@type": "dai:Rule", "dai:action": "stay alone", "dai:actor": "adult cat", "dai:condition": "it has enough food, fresh water and a clean litter box", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FF"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "<=", "dai:limitUnit": "hours", "dai:limitValue": {"@type": "xsd:decimal", "@value": "24.0"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82GM2G3AM0SX444VHV3202J"}, {"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F3"}, {"@id": "ont:cn_01M82GZMM3VP80T7XD6GS67TSK"}, {"@id": "ont:cn_01M82H0CT7BJSF0Q3S0YPNSAE2"}, {"@id": "ont:rl_01M82H3S04Z53GFAPY01PTT049"}, {"@id": "ont:rl_01M82H3S04Z53GFAPY01PTT04A"}, {"@id": "ont:rl_01M82H3S04Z53GFAPY01PTT04B"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Adult cat may stay alone up to 24 hours"},
    {"@id": "ont:ru_01M82H3S04Z53GFAPY01PTT04E", "@type": "dai:Rule", "dai:action": "arrange for someone to visit the cat at least once a day", "dai:actor": "owner", "dai:condition": "the absence is longer than 24 hours", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FF"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": ">=", "dai:limitUnit": "visits per day", "dai:limitValue": {"@type": "xsd:decimal", "@value": "1.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82H3S04Z53GFAPY01PTT047"}, {"@id": "ont:cn_01M82H3S04Z53GFAPY01PTT048"}, {"@id": "ont:rl_01M82H3S04Z53GFAPY01PTT04C"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Arrange daily visits for longer absences"},
    {"@id": "ont:ru_01M82H4A6RYEVMPHHZT3A2AKRA", "@type": "dai:Rule", "dai:action": "keep the cat in a closed room with its litter box", "dai:actor": "owner", "dai:condition": "on moving day", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GY6D4FG58KKX81F7CX0F1"}, {"@id": "ont:cn_01M82GZMM3VP80T7XD6GS67TSK"}, {"@id": "ont:cn_01M82H4A6QBXBQ8J6YR1AX969R"}, {"@id": "ont:cn_01M82H4A6QBXBQ8J6YR1AX969T"}, {"@id": "ont:rl_01M82H4A6RYEVMPHHZT3A2AKR6"}, {"@id": "ont:rl_01M82H4A6RYEVMPHHZT3A2AKR7"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Keep cat in closed room with litter box on moving day"},
    {"@id": "ont:ru_01M82H4A6RYEVMPHHZT3A2AKRB", "@type": "dai:Rule", "dai:action": "keep an outdoor cat indoors before letting it outside, so that it learns its new home", "dai:actor": "owner", "dai:condition": "after the move", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": ">=", "dai:limitUnit": "weeks", "dai:limitValue": {"@type": "xsd:decimal", "@value": "2.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GYVM9BBT0CS4ZCPR3ER6J"}, {"@id": "ont:cn_01M82H4A6QBXBQ8J6YR1AX969Q"}, {"@id": "ont:cn_01M82H4A6RYEVMPHHZT3A2AKR4"}, {"@id": "ont:rl_01M82H4A6RYEVMPHHZT3A2AKR8"}], "dai:scope": {"@id": "ont:co_01M82GXF5A3M9Z44ZD3X2YY7HZ"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Keep outdoor cat indoors after move"},
    {"@id": "ont:ru_01M82H7HC0Y79J6K9SG7H0Z9KB", "@type": "dai:Rule", "dai:action": "follow the house rules", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTG"}, {"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTQ"}, {"@id": "ont:rl_01M82H7HC0Y79J6K9SG7H0Z9K8"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every resident must follow the house rules"},
    {"@id": "ont:ru_01M82H7HC0Y79J6K9SG7H0Z9KC", "@type": "dai:Rule", "dai:action": "enforce the house rules", "dai:actor": "house management", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTH"}, {"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTQ"}, {"@id": "ont:rl_01M82H7HC0Y79J6K9SG7H0Z9K7"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "House management enforces the house rules"},
