    {"@id": "ont:ru_01M82HDX94TC4A36YAZSDB0R50", "@type": "dai:Rule", "dai:action": "carry out noisy work such as drilling", "dai:actor": "resident", "dai:condition": "on weekdays from 08:00 to 12:00 and from 14:00 to 18:00", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82H83Q82K5CKBRM346N833A"}, {"@id": "ont:cn_01M82HDX94TC4A36YAZSDB0R4Q"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work allowed on weekdays 08:00-12:00 and 14:00-18:00"},
    {"@id": "ont:ru_01M82HDX94TC4A36YAZSDB0R51", "@type": "dai:Rule", "dai:action": "carry out noisy work such as drilling", "dai:actor": "resident", "dai:condition": "on Saturdays from 09:00 to 12:00", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82H83Q82K5CKBRM346N833A"}, {"@id": "ont:cn_01M82HDX94TC4A36YAZSDB0R4Q"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work allowed on Saturdays 09:00-12:00"},
    {"@id": "ont:ru_01M82HDX94TC4A36YAZSDB0R52", "@type": "dai:Rule", "dai:action": "announce a move to the house management in advance", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": ">=", "dai:limitUnit": "days", "dai:limitValue": {"@type": "xsd:decimal", "@value": "7.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H4A6QBXBQ8J6YR1AX969Q"}, {"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTH"}, {"@id": "ont:rl_01M82HDX94TC4A36YAZSDB0R4X"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Announce a move at least 7 days in advance"},
    {"@id": "ont:ru_01M82HDX94TC4A36YAZSDB0R53", "@type": "dai:Rule", "dai:action": "protect the lift with the covers provided", "dai:actor": "resident", "dai:condition": "when moving", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82H4A6QBXBQ8J6YR1AX969Q"}, {"@id": "ont:cn_01M82HA4JVD4MJZ6M8W4CVWNW0"}, {"@id": "ont:cn_01M82HDX94TC4A36YAZSDB0R4W"}, {"@id": "ont:rl_01M82HDX94TC4A36YAZSDB0R4Y"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Protect the lift with the provided covers during a move"},
    {"@id": "ont:ru_01M82HED58S76FTH809VQEMZD0", "@type": "dai:Rule", "dai:action": "report damage, noise complaints and rule violations to the house management in writing", "dai:actor": "resident", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN2"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82GV0DCSP2BSTQA19ENCPJ1"}, {"@id": "ont:cn_01M82H7HBZP5REB8E6N9M29JTH"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCM"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCP"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCQ"}, {"@id": "ont:rl_01M82HED58S76FTH809VQEMZCV"}, {"@id": "ont:rl_01M82HED58S76FTH809VQEMZCW"}, {"@id": "ont:rl_01M82HED58S76FTH809VQEMZCX"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Report damage, noise complaints and violations in writing"},
    {"@id": "ont:ru_01M82HED58S76FTH809VQEMZD1", "@type": "dai:Rule", "dai:action": "terminate the tenancy", "dai:actor": "house management", "dai:condition": "violations are repeated after a written warning", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN2"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:may"}, "dai:refersTo": [{"@id": "ont:cn_01M82HED58S76FTH809VQEMZCQ"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCR"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCS"}, {"@id": "ont:cn_01M82HED58S76FTH809VQEMZCT"}, {"@id": "ont:rl_01M82HED58S76FTH809VQEMZCY"}], "dai:scope": {"@id": "ont:co_01M82H6T2RFZXKEGGF51P3J7NK"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Repeated violations after warning may lead to termination"},
    {"@id": "ont:st_01M82GJP3CRKNX3DNJZDNANDW8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog lives 10 to 15 years."},
    {"@id": "ont:st_01M82GJP3CRKNX3DNJZDNANDW9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog needs daily exercise, company, training and veterinary care for its whole life."},
    {"@id": "ont:st_01M82GJP3CRKNX3DNJZDNANDWA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Before you get a dog, check that your home, your working hours and your budget fit the dog you want."},
    {"@id": "ont:st_01M82GJP3CRKNX3DNJZDNANDWB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCF"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog older than 4 months must be registered with the local authority."},
    {"@id": "ont:st_01M82GJP3CRKNX3DNJZDNANDWC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCF"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog older than 4 months must carry a microchip."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCH"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Breeds differ in size, energy and the care they need."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Small companion breeds need less space and less exercise and adapt well to flats."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Large and working breeds need more space, more exercise and more mental work."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCM"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired breeds need more grooming than short-haired breeds."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCN"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Some breeds are classified as dangerous by the local authority."},
    {"@id": "ont:st_01M82GKFJ8XS99C5698GHNMET5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCN"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Check the local list of dangerous breeds before you choose a breed."},
    {"@id": "ont:st_01M82GM2G2RQN4BGFYPS36BGYC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCQ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog is fed twice a day."},
    {"@id": "ont:st_01M82GM2G2RQN4BGFYPS36BGYD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCQ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy is fed three to four times a day."},
    {"@id": "ont:st_01M82GM2G2RQN4BGFYPS36BGYE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCQ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Fresh water must always be available."},
    {"@id": "ont:st_01M82GM2G2RQN4BGFYPS36BGYF", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCQ"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Chocolate, grapes, onions and xylitol are poisonous to dogs."},
    {"@id": "ont:st_01M82GMKV1KS5PBE1QB2P99CNY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCS"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy receives its first vaccinations at 8 weeks of age."},
    {"@id": "ont:st_01M82GMKV1KS5PBE1QB2P99CNZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCS"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination is mandatory."},
    {"@id": "ont:st_01M82GMKV1KS5PBE1QB2P99CP0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCS"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination must be renewed every year."},
    {"@id": "ont:st_01M82GMKV1KS5PBE1QB2P99CP1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCS"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog is taken to the veterinarian for a check-up at least once a year."},
    {"@id": "ont:st_01M82GN67PPA4W9M9C62QPP3NC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCV"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog must be brushed at least once a week."},
    {"@id": "ont:st_01M82GN67PPA4W9M9C62QPP3ND", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCV"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired breeds need brushing every day."},
    {"@id": "ont:st_01M82GN67PPA4W9M9C62QPP3NE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCV"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Trim the dog's claws when you can hear them clicking on the floor."},
    {"@id": "ont:st_01M82GN67QTV2KDH6NRHKR2RZN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCV"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Wash the dog's bed and blankets once a week at 60 °C."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7G", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNY"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy is a dog younger than 6 months."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7H", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNY"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Puppies should not leave their mother before 8 weeks of age."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7J", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "House training starts on the first day."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7K", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Take the puppy outside after every meal, after every nap and after play."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7M", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Praise the puppy when it relieves itself outside."},
    {"@id": "ont:st_01M82GNRCASH6DKSRYKE0WQE7N", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Between 8 and 16 weeks, the puppy should calmly get to know many people, sounds, surfaces and traffic."},
    {"@id": "ont:st_01M82GPB8YAGPD1GP8XNKV421W", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP1"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A leash of 1.5 to 2 metres should be used for everyday walks."},
    {"@id": "ont:st_01M82GPB8ZK0N7S1VR303H5EP2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP1"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A retractable leash is not suitable in busy streets."},
    {"@id": "ont:st_01M82GPB8ZK0N7S1VR303H5EP3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP1"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The leash is attached to a well-fitting collar or harness."},
    {"@id": "ont:st_01M82GPB8ZK0N7S1VR303H5EP4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP1"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A well-fitting collar allows two fingers to slide under it."},
    {"@id": "ont:st_01M82GPTF0J0A1WWEWDR3G29F7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP3"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Leash training starts when the puppy is 8 to 10 weeks old."},
    {"@id": "ont:st_01M82GPTF0J0A1WWEWDR3G29F8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The dog is rewarded when the leash is loose."},
    {"@id": "ont:st_01M82GPTF0J0A1WWEWDR3G29F9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Walking stops when the dog pulls on the leash."},
    {"@id": "ont:st_01M82GPTF0J0A1WWEWDR3G29FA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The leash is never jerked."},
    {"@id": "ont:st_01M82GQHZCWYDZ4FY134N19HQR", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog needs at least two walks a day."},
    {"@id": "ont:st_01M82GQHZCWYDZ4FY134N19HQS", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Small breeds need 30 to 60 minutes of walks a day in total."},
    {"@id": "ont:st_01M82GQHZCWYDZ4FY134N19HQT", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Large and working breeds need up to 2 hours of walks a day."},
    {"@id": "ont:st_01M82GQHZCWYDZ4FY134N19HQV", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A puppy must be taken outside to relieve itself every 2 to 3 hours."},
    {"@id": "ont:st_01M82GQHZCWYDZ4FY134N19HQW", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner must always pick up the dog's waste and put it in a waste bin."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF77", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog looks to its owner for direction."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF78", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner should be the dog's lead: a calm, consistent and confident leader whose signals the dog can trust."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF79", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP8"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The same command words should be used every time, and everyone in the family should use them."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF7A", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP9"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner should set clear rules for the dog, such as whether it may lie on the sofa, and keep them."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF7B", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPA"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Good behaviour should be rewarded immediately."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF7C", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPA"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Unwanted behaviour should be ignored instead of shouting."},
    {"@id": "ont:st_01M82GR8C6YNAW05QP8GX3MF7D", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPB"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog that does not see its owner as a reliable lead may become anxious or try to take control."},
    {"@id": "ont:st_01M82GS0NSGHH6X6DCYVS251BE", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every dog should learn five basic commands: sit, down, stay, come and leave it."},
    {"@id": "ont:st_01M82GS0NSGHH6X6DCYVS251BF", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Training is done in short sessions of 5 to 10 minutes, several times a day."},
    {"@id": "ont:st_01M82GS0NSGHH6X6DCYVS251BG", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A training session should always end with a success."},
    {"@id": "ont:st_01M82GS0NSGHH6X6DCYVS251BH", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPE"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog training course with a certified trainer is recommended in the first year."},
    {"@id": "ont:st_01M82GS0NSGHH6X6DCYVS251BJ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPE"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs of breeds classified as dangerous must pass an obedience test."},
    {"@id": "ont:st_01M82GSR24145KC6KF8V0HWF91", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3Q"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs are social animals."},
    {"@id": "ont:st_01M82GSR24145KC6KF8V0HWF92", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3Q"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult dog must never be left alone at home for more than 6 hours."},
    {"@id": "ont:st_01M82GSR24145KC6KF8V0HWF93", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3Q"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Puppies should not be left alone for more than 2 hours."},
    {"@id": "ont:st_01M82GSR24145KC6KF8V0HWF94", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3R"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Before leaving, the owner should walk the dog, leave water and a safe chew toy, and keep the departure low-key."},
    {"@id": "ont:st_01M82GSR24145KC6KF8V0HWF95", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3R"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "If a dog barks or howls while the owner is away, the owner should train it to be alone step by step, starting with a few minutes."},
    {"@id": "ont:st_01M82GTCESJWWYNZ6F9GB3P9VM", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3T"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "In a car, a dog must travel in a crate or wear a safety harness attached to the seat belt."},
    {"@id": "ont:st_01M82GTCESJWWYNZ6F9GB3P9VN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3T"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A dog must never be left in a parked car in warm weather."},
    {"@id": "ont:st_01M82GTCESJWWYNZ6F9GB3P9VP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3T"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "For travel abroad, a dog needs a pet passport, a microchip and a valid rabies vaccination."},
    {"@id": "ont:st_01M82GV0DCSP2BSTQA19ENCPHJ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3W"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The dog owner is liable for any damage the dog causes."},
    {"@id": "ont:st_01M82GV0DCSP2BSTQA19ENCPHK", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3W"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Third-party liability insurance for dog owners is strongly recommended."},
    {"@id": "ont:st_01M82GV0DCSP2BSTQA19ENCPHM", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3W"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Third-party liability insurance is mandatory for breeds classified as dangerous by the local authority."},
    {"@id": "ont:st_01M82GV0DCSP2BSTQA19ENCPHN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3W"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "In public places, a dog must be kept on a leash unless a sign allows free running."},
    {"@id": "ont:st_01M82GY6D3EBA09WTHVE729V27", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat lives 12 to 18 years."},
    {"@id": "ont:st_01M82GY6D4FG58KKX81F7CX0EP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats are independent."},
    {"@id": "ont:st_01M82GY6D4FG58KKX81F7CX0EQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats still need daily attention, play and a clean environment."},
    {"@id": "ont:st_01M82GY6D4FG58KKX81F7CX0ER", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for food and litter."},
    {"@id": "ont:st_01M82GY6D4FG58KKX81F7CX0ES", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for yearly veterinary visits."},
    {"@id": "ont:st_01M82GY6D4FG58KKX81F7CX0ET", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A future cat owner should plan for someone to look after the cat when they travel."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER63", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2Z"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The owner should decide early whether the cat will be an indoor cat or an outdoor cat."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER64", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB30"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An indoor cat never leaves the flat."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER65", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB30"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "On average an indoor cat lives longer."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER66", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB30"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An indoor cat needs more play and climbing places."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER67", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB31"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An outdoor cat goes outside on its own."},
    {"@id": "ont:st_01M82GYVM9BBT0CS4ZCPR3ER68", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB31"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An outdoor cat must be vaccinated and microchipped before it goes outside for the first time."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a litter box."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a scratching post."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs food and water bowls."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Food and water bowls are placed away from the litter box."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS6", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every cat needs a quiet place to sleep."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Windows and balconies are to be secured with a net."},
    {"@id": "ont:st_01M82GZMM3VP80T7XD6GS67TS8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats can fall from height."},
    {"@id": "ont:st_01M82H0CT6HYQ75KPNQXY0PMEX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult cat should be fed two to three small meals a day."},
    {"@id": "ont:st_01M82H0CT6HYQ75KPNQXY0PMEY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens need four meals a day."},
    {"@id": "ont:st_01M82H0CT6HYQ75KPNQXY0PMEZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats need meat-based food."},
    {"@id": "ont:st_01M82H0CT6HYQ75KPNQXY0PMF0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lilies, onions, chocolate and dog food are not suitable for cats."},
    {"@id": "ont:st_01M82H0CT6HYQ75KPNQXY0PMF1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lilies are highly poisonous to cats."},
    {"@id": "ont:st_01M82H115ABPPRSFHS5N8011NX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A kitten receives its first vaccinations at 8 weeks of age."},
    {"@id": "ont:st_01M82H115ABPPRSFHS5N8011NY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that goes outdoors must also be vaccinated against rabies."},
    {"@id": "ont:st_01M82H115ABPPRSFHS5N8011NZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The rabies vaccination of an outdoor cat is renewed every year."},
    {"@id": "ont:st_01M82H115ABPPRSFHS5N8011P0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat should be neutered at about 5 to 6 months of age."},
    {"@id": "ont:st_01M82H115ABPPRSFHS5N8011P1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The cat should visit the veterinarian at least once a year."},
    {"@id": "ont:st_01M82H1MQPVEX27Q0YHCNZ9WDJ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Provide one litter box per cat plus one extra."},
    {"@id": "ont:st_01M82H1MQPVEX27Q0YHCNZ9WDK", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Clumps are removed from the litter box every day."},
    {"@id": "ont:st_01M82H1MQPVEX27Q0YHCNZ9WDM", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F7"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "All litter is replaced once a week."},
    {"@id": "ont:st_01M82H1MQPVEX27Q0YHCNZ9WDN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F7"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Used litter goes into the residual waste, never into the toilet or the compost."},
    {"@id": "ont:st_01M82H22REK3TH3893EQK4YE0G", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A kitten is a cat younger than 6 months."},
    {"@id": "ont:st_01M82H22REK3TH3893EQK4YE0H", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens should not leave their mother before 12 weeks of age."},
    {"@id": "ont:st_01M82H22REK3TH3893EQK4YE0J", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A new kitten should explore one room first, then the rest of the flat."},
    {"@id": "ont:st_01M82H22REK3TH3893EQK4YE0K", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kittens learn to use the litter box quickly if it is easy to reach."},
    {"@id": "ont:st_01M82H2KZE881EPDPP32PV6RFY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An owner should play with their cat for at least 15 minutes twice a day."},
    {"@id": "ont:st_01M82H2KZE881EPDPP32PV6RFZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that scratches furniture usually needs a better scratching post, not punishment."},
    {"@id": "ont:st_01M82H2KZE881EPDPP32PV6RG0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat must never be punished physically."},
    {"@id": "ont:st_01M82H2KZE881EPDPP32PV6RG1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat that suddenly stops using its litter box may be ill and should see a veterinarian."},
    {"@id": "ont:st_01M82H394WWKSMY0HG5WFCNG9T", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Short-haired cats groom themselves."},
    {"@id": "ont:st_01M82H394WWKSMY0HG5WFCNG9V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Short-haired cats should be brushed once a week to reduce hair in the flat."},
    {"@id": "ont:st_01M82H394WWKSMY0HG5WFCNG9W", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Long-haired cats need brushing every day to prevent matting."},
    {"@id": "ont:st_01M82H394WWKSMY0HG5WFCNG9X", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A cat should not be bathed unless the veterinarian advises it."},
    {"@id": "ont:st_01M82H3S04Z53GFAPY01PTT03T", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FF"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "An adult cat can stay alone for up to 24 hours if it has enough food, fresh water and a clean litter box."},
    {"@id": "ont:st_01M82H3S04Z53GFAPY01PTT03V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FF"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "For absences longer than 24 hours, someone should visit the cat at least once a day."},
    {"@id": "ont:st_01M82H4A6QBXBQ8J6YR1AX9699", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats are attached to their territory."},
    {"@id": "ont:st_01M82H4A6QBXBQ8J6YR1AX969A", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "On moving day, the cat is kept in a closed room with its litter box."},
    {"@id": "ont:st_01M82H4A6QBXBQ8J6YR1AX969B", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "After the move, an outdoor cat is kept indoors for at least 2 weeks before it is let outside, so that it learns its new home."},
    {"@id": "ont:st_01M82H7HBZP5REB8E6N9M29JT3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "These rules apply to buildings A, B and C around the shared inner yard."},
    {"@id": "ont:st_01M82H7HBZP5REB8E6N9M29JT4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A resident is anyone who lives in one of the buildings: tenants, owners and their household members."},
    {"@id": "ont:st_01M82H7HBZP5REB8E6N9M29JT5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The house management administers the buildings."},
    {"@id": "ont:st_01M82H7HBZP5REB8E6N9M29JT6", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The house management enforces these rules."},
    {"@id": "ont:st_01M82H7HBZP5REB8E6N9M29JT7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every resident must follow these rules."},
    {"@id": "ont:st_01M82H83Q71ZV34MSQ9AQZ0HE2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Quiet hours are from 22:00 to 07:00 on weekdays."},
    {"@id": "ont:st_01M82H83Q82K5CKBRM346N832V", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Quiet hours are from 22:00 to 09:00 on weekends and public holidays."},
    {"@id": "ont:st_01M82H83Q82K5CKBRM346N832W", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "During quiet hours, residents must avoid noise that can be heard in other flats or in the inner yard."},
    {"@id": "ont:st_01M82H83Q82K5CKBRM346N832X", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX3"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noise to be avoided during quiet hours includes music, drilling and persistent barking."},
    {"@id": "ont:st_01M82H8PHVK3AFBB4S3RR45YAR", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX5"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The inner yard is shared by all residents."},
    {"@id": "ont:st_01M82H94Y19DEFXTHPXP970KG3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX7"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Every pet (dog or cat) must be registered with the house management within 14 days of moving in or acquiring the pet."},
    {"@id": "ont:st_01M82H94Y19DEFXTHPXP970KG4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX7"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A pet owner must make sure that their pet does not disturb other residents."},
    {"@id": "ont:st_01M82HA4JTFTWA7AZK127XE1DW", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMH"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs must be kept on a lead at all times in the inner yard, the stairwells and the lifts."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNV5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMH"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The lead may not be longer than 2 metres."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNV6", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMJ"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dogs may not relieve themselves in the inner yard or the flower beds."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNV7", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMJ"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Dog owners take their dogs outside the building complex to relieve themselves."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNV8", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The maximum time a dog may be left alone in a flat depends on the dog's training and its specific breed."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNV9", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMK"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Owners are responsible for knowing the alone-time limit that applies to their dog."},
    {"@id": "ont:st_01M82HA4JVD4MJZ6M8W4CVWNVA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMM"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "If a dog barks persistently while left alone, the house management may require the owner to arrange care."},
    {"@id": "ont:st_01M82HAMBHA8TEWR617B2TSCWN", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMP"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats may move freely in the inner yard."},
    {"@id": "ont:st_01M82HAMBHA8TEWR617B2TSCWP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMP"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Cats may not be kept in the stairwells or the cellar."},
    {"@id": "ont:st_01M82HAMBHA8TEWR617B2TSCWQ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMP"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Litter boxes must be kept inside the flat."},
    {"@id": "ont:st_01M82HBAX6EM7Y80JHXJSGY7MP", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMR"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Waste is sorted in the bin room of building B into paper, plastic, glass, organic waste and residual waste."},
    {"@id": "ont:st_01M82HBAX7NMYFG8GE4P9Y56ET", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMR"}, "dai:level": {"@id": "dai:level-1"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Pet waste and used cat litter go into the residual waste bin only."},
    {"@id": "ont:st_01M82HBAX7NMYFG8GE4P9Y56EV", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMR"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Bulky items must be booked for collection with the house management."},
    {"@id": "ont:st_01M82HBZKCWB6HP1MM7REEF3K1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMT"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Stairwells, corridors and escape routes must be kept free of objects."},
    {"@id": "ont:st_01M82HBZKCWB6HP1MM7REEF3K2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMT"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Pet equipment must not be left in stairwells, corridors or escape routes."},
    {"@id": "ont:st_01M82HBZKCWB6HP1MM7REEF3K3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMT"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Prams and shoes must not be left in stairwells, corridors or escape routes."},
    {"@id": "ont:st_01M82HBZKCWB6HP1MM7REEF3K4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMT"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Smoking is not allowed in any shared indoor space."},
    {"@id": "ont:st_01M82HCHQC6AK72JNVEQYR1KXA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The main doors of each building stay closed and locked from 22:00 to 06:00."},
    {"@id": "ont:st_01M82HCHQC6AK72JNVEQYR1KXB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Residents open the main doors with their own key."},
    {"@id": "ont:st_01M82HCHQC6AK72JNVEQYR1KXC", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Strangers must not be let into the building."},
    {"@id": "ont:st_01M82HCHQC6AK72JNVEQYR1KXD", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Lost keys must be reported to the house management at once."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The shared laundry room is in the cellar of building A."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH1", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "The shared laundry room may be used from 07:00 to 21:00."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH2", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A slot for the laundry room is booked on the list at the door."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH3", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Pet blankets, pet beds and other pet textiles may not be washed in the shared washing machines."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH4", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Each flat has one cellar compartment."},
    {"@id": "ont:st_01M82HDB2F6BK5KDQ92WEFACH5", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY"}, "dai:level": {"@id": "dai:level-2"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Flammable liquids may not be stored in the cellar compartment."},
    {"@id": "ont:st_01M82HDX93HC2JTNXJNPKNQKMX", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work such as drilling is allowed on weekdays from 08:00 to 12:00 and from 14:00 to 18:00."},
    {"@id": "ont:st_01M82HDX93HC2JTNXJNPKNQKMY", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Noisy work such as drilling is allowed on Saturdays from 09:00 to 12:00."},
    {"@id": "ont:st_01M82HDX93HC2JTNXJNPKNQKMZ", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "A move must be announced to the house management at least 7 days in advance."},
    {"@id": "ont:st_01M82HDX93HC2JTNXJNPKNQKN0", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "During a move the lift must be protected with the covers provided."},
    {"@id": "ont:st_01M82HED58S76FTH809VQEMZCA", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN2"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Damage, noise complaints and rule violations are reported to the house management in writing."},
    {"@id": "ont:st_01M82HED58S76FTH809VQEMZCB", "@type": "dai:Statement", "dai:evidence": {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN2"}, "dai:level": {"@id": "dai:level-3"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Repeated violations after a written warning may lead to termination of the tenancy."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCE", "@type": "dai:SourceUnit", "rdfs:label": "A dog lives 10 to 15 years. It needs daily exercise, company, training and veterinary care for its whole life. Before you get a dog, check that your home, your working hours and your budget fit the dog you want."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCF", "@type": "dai:SourceUnit", "rdfs:label": "A dog older than 4 months must be registered with the local authority and must carry a microchip."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCH", "@type": "dai:SourceUnit", "rdfs:label": "Breeds differ in size, energy and the care they need."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCJ", "@type": "dai:SourceUnit", "rdfs:label": "**Small companion breeds** (for example, Maltese or Pug) need less space and less exercise and adapt well to flats."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCK", "@type": "dai:SourceUnit", "rdfs:label": "**Large and working breeds** (for example, Border Collie or German Shepherd) need more space, more exercise and more mental work."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCM", "@type": "dai:SourceUnit", "rdfs:label": "**Long-haired breeds** need more grooming than short-haired breeds."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCN", "@type": "dai:SourceUnit", "rdfs:label": "Some breeds are classified as dangerous by the local authority. Check the local list before you choose a breed."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCQ", "@type": "dai:SourceUnit", "rdfs:label": "Feed an adult dog twice a day and a puppy three to four times a day. Fresh water must always be available. Chocolate, grapes, onions and xylitol are poisonous to dogs."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCS", "@type": "dai:SourceUnit", "rdfs:label": "A puppy receives its first vaccinations at 8 weeks of age. The rabies vaccination is mandatory and must be renewed every year. Take your dog to the veterinarian for a check-up at least once a year."},
    {"@id": "ont:su_01M82GHYMP28WWGVJCAF7BMQCV", "@type": "dai:SourceUnit", "rdfs:label": "Brush your dog at least once a week; long-haired breeds need brushing every day. Trim the claws when you can hear them clicking on the floor. Wash your dog's bed and blankets once a week at 60 °C."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNY", "@type": "dai:SourceUnit", "rdfs:label": "A puppy is a dog younger than 6 months. Puppies should not leave their mother before 8 weeks of age."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDNZ", "@type": "dai:SourceUnit", "rdfs:label": "House training starts on the first day: take the puppy outside after every meal, after every nap and after play, and praise it when it relieves itself outside. Between 8 and 16 weeks, let the puppy get to know many people, sounds, surfaces and traffic in a calm way."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP1", "@type": "dai:SourceUnit", "rdfs:label": "Use a leash of 1.5 to 2 metres for everyday walks. A retractable leash is not suitable in busy streets. Attach the leash to a well-fitting collar or harness: you should be able to slide two fingers under the collar."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP3", "@type": "dai:SourceUnit", "rdfs:label": "Start leash training when the puppy is 8 to 10 weeks old. Reward the dog when the leash is loose, and stop walking when the dog pulls. Never jerk the leash."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP5", "@type": "dai:SourceUnit", "rdfs:label": "An adult dog needs at least two walks a day: 30 to 60 minutes in total for small breeds and up to 2 hours for large and working breeds. A puppy must be taken outside to relieve itself every 2 to 3 hours. Always pick up your dog's waste and put it in a waste bin."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP7", "@type": "dai:SourceUnit", "rdfs:label": "Your dog looks to you for direction. Be its lead: a calm, consistent and confident leader whose signals it can trust."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP8", "@type": "dai:SourceUnit", "rdfs:label": "Use the same command words every time, and make sure everyone in the family uses them too."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDP9", "@type": "dai:SourceUnit", "rdfs:label": "Set clear rules (for example, whether the dog may lie on the sofa) and keep them."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPA", "@type": "dai:SourceUnit", "rdfs:label": "Reward good behaviour immediately; ignore unwanted behaviour instead of shouting."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPB", "@type": "dai:SourceUnit", "rdfs:label": "A dog that does not see its owner as a reliable lead may become anxious or try to take control."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPD", "@type": "dai:SourceUnit", "rdfs:label": "Every dog should learn five basic commands: *sit*, *down*, *stay*, *come* and *leave it*. Train in short sessions of 5 to 10 minutes, several times a day, and always end with a success."},
    {"@id": "ont:su_01M82GHYMQYRXNHXCXTMK9HDPE", "@type": "dai:SourceUnit", "rdfs:label": "A dog training course with a certified trainer is recommended in the first year. Dogs of breeds classified as dangerous must pass an obedience test."},
    {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3Q", "@type": "dai:SourceUnit", "rdfs:label": "Dogs are social animals. **Never leave an adult dog alone at home for more than 6 hours.** Puppies should not be left alone for more than 2 hours."},
    {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3R", "@type": "dai:SourceUnit", "rdfs:label": "Before you leave, walk the dog, leave water and a safe chew toy, and keep your departure low-key. If your dog barks or howls while you are away, train it to be alone step by step, starting with a few minutes."},
    {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3T", "@type": "dai:SourceUnit", "rdfs:label": "In a car, a dog must travel in a crate or wear a safety harness attached to the seat belt. Never leave a dog in a parked car in warm weather. For travel abroad, your dog needs a pet passport, a microchip and a valid rabies vaccination."},
    {"@id": "ont:su_01M82GHYMR2WSZZZXCEPR86V3W", "@type": "dai:SourceUnit", "rdfs:label": "You are liable for any damage your dog causes. Third-party liability insurance for dog owners is strongly recommended, and it is mandatory for breeds classified as dangerous by the local authority. In public places, your dog must be kept on a leash unless a sign allows free running."},
    {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2X", "@type": "dai:SourceUnit", "rdfs:label": "A cat lives 12 to 18 years. Cats are independent, but they still need daily attention, play and a clean environment. Plan for food, litter, yearly veterinary visits and someone to look after the cat when you travel."},
    {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB2Z", "@type": "dai:SourceUnit", "rdfs:label": "Decide early whether your cat will be an indoor cat or an outdoor cat."},
    {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB30", "@type": "dai:SourceUnit", "rdfs:label": "An **indoor cat** never leaves the flat. On average it lives longer, but it needs more play and climbing places."},
    {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB31", "@type": "dai:SourceUnit", "rdfs:label": "An **outdoor cat** goes outside on its own. It must be vaccinated and microchipped before it goes outside for the first time."},
    {"@id": "ont:su_01M82GXF5BZJDB4QGXVFMJEB33", "@type": "dai:SourceUnit", "rdfs:label": "Every cat needs a litter box, a scratching post, food and water bowls placed away from the litter box, and a quiet place to sleep. Secure windows and balconies with a net, because cats can fall from height."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F3", "@type": "dai:SourceUnit", "rdfs:label": "Feed an adult cat two to three small meals a day; kittens need four meals a day. Cats need meat-based food. Lilies, onions, chocolate and dog food are not suitable for cats; lilies are highly poisonous."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F5", "@type": "dai:SourceUnit", "rdfs:label": "A kitten receives its first vaccinations at 8 weeks of age. A cat that goes outdoors must also be vaccinated against rabies, renewed every year. Neuter your cat at about 5 to 6 months of age. Visit the veterinarian at least once a year."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F7", "@type": "dai:SourceUnit", "rdfs:label": "Provide one litter box per cat plus one extra. Remove clumps every day and replace all litter once a week. Used litter goes into the residual waste, never into the toilet or the compost."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5F9", "@type": "dai:SourceUnit", "rdfs:label": "A kitten is a cat younger than 6 months. Kittens should not leave their mother before 12 weeks of age. Let a new kitten explore one room first, then the rest of the flat. Kittens learn to use the litter box quickly if it is easy to reach."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FB", "@type": "dai:SourceUnit", "rdfs:label": "Play with your cat for at least 15 minutes twice a day. A cat that scratches furniture usually needs a better scratching post, not punishment. Never punish a cat physically. A cat that suddenly stops using its litter box may be ill and should see a veterinarian."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FD", "@type": "dai:SourceUnit", "rdfs:label": "Short-haired cats groom themselves; brush them once a week to reduce hair in the flat. Long-haired cats need brushing every day to prevent matting. Do not bathe a cat unless the veterinarian advises it."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FF", "@type": "dai:SourceUnit", "rdfs:label": "An adult cat can stay alone for up to 24 hours if it has enough food, fresh water and a clean litter box. For longer absences, arrange for someone to visit the cat at least once a day."},
    {"@id": "ont:su_01M82GXF5CK27HSSNSY54SX5FH", "@type": "dai:SourceUnit", "rdfs:label": "Cats are attached to their territory. On moving day, keep the cat in a closed room with its litter box. After the move, keep an outdoor cat indoors for at least 2 weeks before you let it outside, so that it learns its new home."},
    {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX1", "@type": "dai:SourceUnit", "rdfs:label": "These rules apply to buildings A, B and C around the shared inner yard. A **resident** is anyone who lives in one of the buildings: tenants, owners and their household members. The **house management** administers the buildings and enforces these rules. Every resident must follow them."},
    {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX3", "@type": "dai:SourceUnit", "rdfs:label": "Quiet hours are from 22:00 to 07:00 on weekdays and from 22:00 to 09:00 on weekends and public holidays. During quiet hours, residents must avoid noise that can be heard in other flats or in the inner yard, including music, drilling and persistent barking."},
    {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX5", "@type": "dai:SourceUnit", "rdfs:label": "The inner yard is shared by all residents. Children may play there between 08:00 and 20:00. Bicycles must be parked in the bicycle racks only. Barbecues are allowed only in the marked barbecue area and never during quiet hours."},
    {"@id": "ont:su_01M82H6T2SJCWQ88GWH3NA9WX7", "@type": "dai:SourceUnit", "rdfs:label": "Every pet (dog or cat) must be registered with the house management within 14 days of moving in or acquiring the pet. A pet owner must make sure that their pet does not disturb other residents."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMH", "@type": "dai:SourceUnit", "rdfs:label": "Dogs must be kept on a lead at all times in the inner yard, the stairwells and the lifts. The lead may not be longer than 2 metres."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMJ", "@type": "dai:SourceUnit", "rdfs:label": "Dogs may not relieve themselves in the inner yard or the flower beds. Dog owners take their dogs outside the building complex for this."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMK", "@type": "dai:SourceUnit", "rdfs:label": "The maximum time a dog may be left alone in a flat depends on the dog's education (training) and its specific breed. Owners are responsible for knowing the limit that applies to their dog."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMM", "@type": "dai:SourceUnit", "rdfs:label": "If a dog barks persistently while left alone, the house management may require the owner to arrange care."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMP", "@type": "dai:SourceUnit", "rdfs:label": "Cats may move freely in the inner yard. Cats may not be kept in the stairwells or the cellar. Litter boxes must be kept inside the flat."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMR", "@type": "dai:SourceUnit", "rdfs:label": "Waste is sorted in the bin room of building B: paper, plastic, glass, organic waste and residual waste. Pet waste and used cat litter go into the residual waste bin only. Bulky items must be booked for collection with the house management."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMT", "@type": "dai:SourceUnit", "rdfs:label": "Stairwells, corridors and escape routes must be kept free of objects, including prams, shoes and pet equipment. Smoking is not allowed in any shared indoor space."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMW", "@type": "dai:SourceUnit", "rdfs:label": "The main doors of each building stay closed and locked from 22:00 to 06:00; residents open them with their own key. Do not let strangers into the building. Lost keys must be reported to the house management at once."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMMY", "@type": "dai:SourceUnit", "rdfs:label": "The shared laundry room is in the cellar of building A and may be used from 07:00 to 21:00. Book a slot on the list at the door. Pet blankets, pet beds and other pet textiles may not be washed in the shared washing machines. Each flat has one cellar compartment; flammable liquids may not be stored there."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN0", "@type": "dai:SourceUnit", "rdfs:label": "Noisy work such as drilling is allowed on weekdays from 08:00 to 12:00 and from 14:00 to 18:00, and on Saturdays from 09:00 to 12:00. Announce a move to the house management at least 7 days in advance, and protect the lift with the covers provided."},
    {"@id": "ont:su_01M82H6T2T27Y7HH29TGSXAMN2", "@type": "dai:SourceUnit", "rdfs:label": "Report damage, noise complaints and rule violations to the house management in writing. Repeated violations after a written warning may lead to termination of the tenancy."},
    {"@id": "urn:domain-ai-assistant:ontology:pets-and-house-rules", "@type": "owl:Ontology", "dcterms:description": "Explain what it takes to own a dog or a cat in a residential complex, and which house rules apply to pets and their owners.", "owl:versionIRI": {"@id": "ont:version-raw+2eff3b2"}, "owl:versionInfo": "raw+2eff3b2"}
  ]
}
