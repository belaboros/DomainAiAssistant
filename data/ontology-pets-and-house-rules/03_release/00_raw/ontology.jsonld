    {"@id": "ont:ru_01M82AG9DZ4Q7M3Z8RX016AKWR", "@type": "dai:Rule", "dai:action": "start leash training when the puppy is 8 to 10 weeks old", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AF7YTEGBGGS9B245D10JJ"}, {"@id": "ont:cn_01M82AG9DZ4Q7M3Z8RX016AKWJ"}, {"@id": "ont:rl_01M82AG9DZ4Q7M3Z8RX016AKWP"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Start leash training at 8 to 10 weeks"},
    {"@id": "ont:ru_01M82AG9DZ4Q7M3Z8RX016AKWS", "@type": "dai:Rule", "dai:action": "reward the dog", "dai:actor": "owner", "dai:condition": "when the leash is loose", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AC66KMJH32E2MQ3Z7ZBKM"}, {"@id": "ont:cn_01M82AFTZDSHCD0SK6T4N2YZW6"}, {"@id": "ont:cn_01M82AG9DZ4Q7M3Z8RX016AKWJ"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Reward the dog when the leash is loose"},
    {"@id": "ont:ru_01M82AG9DZ4Q7M3Z8RX016AKWT", "@type": "dai:Rule", "dai:action": "stop walking", "dai:actor": "owner", "dai:condition": "when the dog pulls", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AC66KMJH32E2MQ3Z7ZBKM"}, {"@id": "ont:cn_01M82AG9DZ4Q7M3Z8RX016AKWJ"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Stop walking when the dog pulls"},
    {"@id": "ont:ru_01M82AG9DZ4Q7M3Z8RX016AKWV", "@type": "dai:Rule", "dai:action": "jerk the leash", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZE"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82AFTZDSHCD0SK6T4N2YZW6"}, {"@id": "ont:rl_01M82AG9DZ4Q7M3Z8RX016AKWQ"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Never jerk the leash"},
    {"@id": "ont:ru_01M82AH1GXVV72WP99JQXMH6XZ", "@type": "dai:Rule", "dai:action": "take an adult dog for walks every day", "dai:actor": "owner", "dai:condition": "the dog is an adult dog", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": ">=", "dai:limitUnit": "walks per day", "dai:limitValue": {"@type": "xsd:decimal", "@value": "2.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82ADJQKNCFSCKCDMA3H0R86"}, {"@id": "ont:cn_01M82AFTZDSHCD0SK6T4N2YZWA"}, {"@id": "ont:rl_01M82AH1GXVV72WP99JQXMH6XW"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Adult dog needs at least two walks a day"},
    {"@id": "ont:ru_01M82AH1GXVV72WP99JQXMH6Y0", "@type": "dai:Rule", "dai:action": "walk an adult small-breed dog 30 to 60 minutes in total per day", "dai:actor": "owner", "dai:condition": "the adult dog is of a small breed", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82ADJQKNCFSCKCDMA3H0R86"}, {"@id": "ont:cn_01M82AFTZDSHCD0SK6T4N2YZWA"}, {"@id": "ont:cn_01M82AH1GXVV72WP99JQXMH6XP"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Total daily walk time for small breeds"},
    {"@id": "ont:ru_01M82AH1GXVV72WP99JQXMH6Y1", "@type": "dai:Rule", "dai:action": "walk an adult large or working breed dog up to 2 hours in total per day", "dai:actor": "owner", "dai:condition": "the adult dog is of a large or working breed", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-2"}, "dai:limitComparator": "<=", "dai:limitUnit": "hours per day", "dai:limitValue": {"@type": "xsd:decimal", "@value": "2.0"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82ADJQKNCFSCKCDMA3H0R86"}, {"@id": "ont:cn_01M82AFTZDSHCD0SK6T4N2YZWA"}, {"@id": "ont:cn_01M82AH1GXVV72WP99JQXMH6XQ"}, {"@id": "ont:cn_01M82AH1GXVV72WP99JQXMH6XR"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Total daily walk time for large and working breeds"},
    {"@id": "ont:ru_01M82AH1GXVV72WP99JQXMH6Y2", "@type": "dai:Rule", "dai:action": "take the puppy outside to relieve itself every 2 to 3 hours", "dai:actor": "owner", "dai:condition": "the dog is a puppy", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-3"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": {"@id": "ont:cn_01M82AF7YTEGBGGS9B245D10JJ"}, "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Take a puppy outside to relieve itself every 2 to 3 hours"},
    {"@id": "ont:ru_01M82AH1GXVV72WP99JQXMH6Y3", "@type": "dai:Rule", "dai:action": "always pick up the dog's waste and put it in a waste bin", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZG"}, "dai:level": {"@id": "dai:level-1"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9Y8"}, {"@id": "ont:cn_01M82AH1GXVV72WP99JQXMH6XS"}, {"@id": "ont:cn_01M82AH1GXVV72WP99JQXMH6XT"}, {"@id": "ont:rl_01M82AH1GXVV72WP99JQXMH6XX"}, {"@id": "ont:rl_01M82AH1GXVV72WP99JQXMH6XY"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Always pick up dog waste and put it in a waste bin"},
    {"@id": "ont:ru_01M82AHPS6SQKW9E9EPJYC3KMY", "@type": "dai:Rule", "dai:action": "be the dog's lead: a calm, consistent and confident leader whose signals it can trust", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZJ"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AC66KMJH32E2MQ3Z7ZBKM"}, {"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9Y8"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMM"}, {"@id": "ont:rl_01M82AHPS6SQKW9E9EPJYC3KMV"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Owner must be the dog's lead"},
    {"@id": "ont:ru_01M82AHPS6SQKW9E9EPJYC3KMZ", "@type": "dai:Rule", "dai:action": "use the same command words every time and make sure everyone in the family uses them too", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZK"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9Y8"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMN"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMP"}, {"@id": "ont:rl_01M82AHPS6SQKW9E9EPJYC3KMW"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Use the same command words every time"},
    {"@id": "ont:ru_01M82AHPS6SQKW9E9EPJYC3KN0", "@type": "dai:Rule", "dai:action": "set clear rules for the dog (for example, whether it may lie on the sofa) and keep them", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZM"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AC66KMJH32E2MQ3Z7ZBKM"}, {"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9Y8"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMQ"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Set clear rules and keep them"},
    {"@id": "ont:ru_01M82AHPS6SQKW9E9EPJYC3KN1", "@type": "dai:Rule", "dai:action": "reward good behaviour immediately", "dai:actor": "owner", "dai:evidence": {"@id": "ont:su_01M82ABDR28HTPAFF4C44FRBZN"}, "dai:level": {"@id": "dai:level-2"}, "dai:modality": {"@id": "dai:must"}, "dai:refersTo": [{"@id": "ont:cn_01M82AE56ZYS5Y2Z0C35ECC9Y8"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMR"}, {"@id": "ont:cn_01M82AHPS6SQKW9E9EPJYC3KMT"}, {"@id": "ont:rl_01M82AHPS6SQKW9E9EPJYC3KMX"}], "dai:scope": {"@id": "ont:co_01M82ABDR0997QP7DGZPPDNF4H"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Reward good behaviour immediately"},
