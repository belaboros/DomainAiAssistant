    {"@id": "ont:ru_01M82AVB4Q3YP83EB2BM9CVNHK", "@type": "dai:Rule", "dai:action": "leave its mother", "dai:actor": "kitten", "dai:condition": "before 12 weeks of age", "dai:evidence": {"@id": "ont:su_01M82APMQ7MGEVFK2CW6002H2Y"}, "dai:level": {"@id": "dai:level-3"}, "dai:limitComparator": "<", "dai:limitUnit": "weeks", "dai:limitValue": {"@type": "xsd:decimal", "@value": "12.0"}, "dai:modality": {"@id": "dai:must_not"}, "dai:refersTo": [{"@id": "ont:cn_01M82AVB4Q3YP83EB2BM9CVNH9"}, {"@id": "ont:cn_01M82AVB4Q3YP83EB2BM9CVNHB"}, {"@id": "ont:rl_01M82AVB4Q3YP83EB2BM9CVNHF"}], "dai:scope": {"@id": "ont:co_01M82APMQ5V0PTBT5SDYAF1JAP"}, "dai:status": {"@id": "dai:proposed"}, "rdfs:label": "Kitten stays with mother until 12 weeks"},
